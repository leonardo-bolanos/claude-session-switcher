#!/usr/bin/env python3
"""
ccl — lista todas las sesiones de Claude Code y salta a la ventana de iTerm que las tiene.

Uso:
    ccl              panel interactivo
    ccl --list       solo lista, sin interaccion
    ccl <n>          salta directo a la sesion numero <n>

El numero de cada sesion es ESTABLE: se guarda en ~/.claude/ccl-numbers.json y se
mantiene entre ejecuciones, aunque la lista se reordene. Se recicla cuando la sesion muere.

Requiere macOS + iTerm2 (el salto de ventana usa AppleScript) y Python 3.7+.

Detecta varias cuentas solo: ~/.claude y cualquier ~/.claude-<algo> con projects/
dentro. Se puede fijar la lista con CCL_CONFIG_DIRS (separada por ':').

LIMITACIONES CONOCIDAS
  - Los campos `aiTitle` y `lastPrompt` salen del transcript interno de Claude Code,
    que no esta documentado y puede cambiar. Se tratan como opcionales: si desaparecen,
    el resto sigue funcionando.

https://github.com/leonardo-bolanos/claude-session-switcher
MIT License
"""

import datetime
import glob
import json
import os
import re
import select
import subprocess
import sys
import termios
import threading
import time
import tty
import unicodedata
from concurrent.futures import ThreadPoolExecutor

HOME = os.path.expanduser("~")
INDEX_FILE = os.path.join(HOME, ".claude", "ccl-numbers.json")
TAIL_BYTES = 65536
REFRESH_SECONDS = 4      # refresco normal, mientras interactuas
REFRESH_IDLE = 20        # si no tocas nada, se relaja a esto
IDLE_AFTER = 120         # segundos sin teclear para considerarte inactivo

# ─────────────────────────────── colores ───────────────────────────────

_TTY = sys.stdout.isatty()


def c(code, text):
    return f"\033[{code}m{text}\033[0m" if _TTY else text


DIM = lambda s: c("2", s)
BOLD = lambda s: c("1", s)
GREEN = lambda s: c("32", s)
YELLOW = lambda s: c("33", s)
CYAN = lambda s: c("36", s)
BLUE = lambda s: c("34", s)
MAGENTA = lambda s: c("35", s)
RED = lambda s: c("31", s)
GREY = lambda s: c("90", s)

ANSI_RE = re.compile(r"\033\[[0-9;]*m")
TTY_RE = re.compile(r"(?:/dev/)?tty[a-z]*\d+")


def char_width(ch):
    """
    Columnas que ocupa un caracter en la terminal.

    No es lo mismo que len(): los ideogramas CJK y muchos emoji ocupan DOS columnas,
    y los diacriticos combinantes cero. Contarlos como uno desalinea las columnas.
    """
    if unicodedata.combining(ch):
        return 0
    return 2 if unicodedata.east_asian_width(ch) in ("W", "F") else 1


def vis(s):
    """Ancho visible en columnas: ignora los codigos de color y cuenta los CJK como 2."""
    return sum(char_width(c) for c in ANSI_RE.sub("", s))


def pad(s, width):
    """ljust consciente de los codigos de color."""
    return s + " " * max(0, width - vis(s))


def clip(s, width):
    """Recorta a un ancho visible, sin partir una secuencia de escape."""
    if vis(s) <= width:
        return s
    out, seen = [], 0
    i = 0
    while i < len(s):
        m = ANSI_RE.match(s, i)
        if m:
            out.append(m.group()); i = m.end(); continue
        w = char_width(s[i])
        if seen + w > width:   # no partir un caracter de doble ancho por la mitad
            break
        out.append(s[i]); seen += w; i += 1
    res = "".join(out)
    # cerrar el color solo si de verdad habia alguno abierto: si no, el reset
    # se veria como texto literal "[0m" en salidas sin color (pipes, --list)
    return res + "\033[0m" if ANSI_RE.search(res) else res


def color_model(m):
    """Cada familia con su color, para reconocerla de un vistazo."""
    if not m:
        return ""
    if m.startswith("opus"):
        return BLUE(m)
    if m.startswith("sonnet"):
        return GREEN(m)
    if m.startswith("haiku"):
        return GREY(m)
    if m.startswith("fable"):
        return MAGENTA(m)
    return m


def color_effort(e):
    """Resalta solo lo caro: xhigh/max saltan a la vista."""
    if not e:
        return ""
    return YELLOW(e) if e in ("xhigh", "max") else DIM(e)


def color_age(ts):
    """Verde lo reciente, gris lo viejo."""
    a = ago(ts)
    if a in ("ahora", "?") or a.startswith("hace ") and a.endswith("m"):
        return GREEN(a)
    if a.startswith("hace "):
        return YELLOW(a)
    return DIM(a)


# ─────────────────────────── recoleccion de datos ───────────────────────────


class SessionsUnavailable(Exception):
    """No se pudo consultar a `claude`. Distinto de 'hay cero sesiones'."""


def config_dirs():
    """
    Directorios de configuracion de Claude Code a consultar.

    Por defecto ~/.claude mas cualquier hermano ~/.claude-<algo> que tenga projects/
    dentro (asi se ven las sesiones de una segunda cuenta sin configurar nada).
    Se puede fijar la lista con CCL_CONFIG_DIRS, separada por ':'.
    """
    override = os.environ.get("CCL_CONFIG_DIRS")
    if override:
        dirs = [os.path.expanduser(p) for p in override.split(":") if p.strip()]
        return [d for d in dirs if os.path.isdir(d)]

    found = [os.path.join(HOME, ".claude")]
    for name in sorted(os.listdir(HOME)):
        if not name.startswith(".claude-"):
            continue
        path = os.path.join(HOME, name)
        if os.path.isdir(os.path.join(path, "projects")):
            found.append(path)
    return [d for d in found if os.path.isdir(d)]


def account_label(cfg_dir):
    """'' para el principal, '-personal' para ~/.claude-personal, etc."""
    base = os.path.basename(cfg_dir)
    return "" if base == ".claude" else base.replace(".claude-", "", 1)


def _sessions_from(cfg_dir):
    env = dict(os.environ, CLAUDE_CONFIG_DIR=cfg_dir)
    try:
        proc = subprocess.run(
            ["claude", "agents", "--cwd", HOME, "--json"],
            capture_output=True, text=True, timeout=30, env=env,
        )
    except FileNotFoundError:
        raise SessionsUnavailable(
            "no encuentro el comando `claude`.\n"
            "  Instala Claude Code, o revisa que este en tu PATH."
        )
    except subprocess.TimeoutExpired:
        raise SessionsUnavailable("`claude agents` no respondio en 30s.")
    except Exception as e:
        raise SessionsUnavailable(f"no pude ejecutar `claude agents`: {e}")

    try:
        out = json.loads(proc.stdout)
    except ValueError:
        detail = (proc.stderr or proc.stdout or "").strip().splitlines()
        hint = f"\n  Dijo: {detail[0][:120]}" if detail else ""
        raise SessionsUnavailable(
            "`claude agents --json` no devolvio JSON. "
            f"Necesitas Claude Code v2.1.139 o superior.{hint}"
        )
    for s in out:
        s["_cfg"] = cfg_dir
        s["_account"] = account_label(cfg_dir)
    return out


def get_sessions():
    """
    Sesiones de TODAS las cuentas detectadas, cada una etiquetada con la suya.

    Lanza SessionsUnavailable solo si falla la primera cuenta (el caso de "claude no
    esta instalado"). Si una cuenta secundaria falla, se ignora: no tiene sentido
    dejar sin panel al usuario porque una config extra este rota.
    """
    dirs = config_dirs()
    if not dirs:
        raise SessionsUnavailable(f"no hay ningun directorio de config en {HOME}/.claude*")

    todas, primero = [], True
    for d in dirs:
        try:
            todas.extend(_sessions_from(d))
        except SessionsUnavailable:
            if primero:
                raise
        primero = False
    return todas


def get_ttys(pids):
    """Un solo `ps` para todos los PIDs -> {pid: tty}."""
    if not pids:
        return {}
    try:
        out = subprocess.run(
            ["ps", "-o", "pid=,tty=", "-p", ",".join(str(p) for p in pids)],
            capture_output=True, text=True, timeout=10,
        ).stdout
    except Exception:
        return {}
    result = {}
    for line in out.strip().splitlines():
        parts = line.split()
        if len(parts) >= 2:
            result[int(parts[0])] = parts[1]
    return result


def get_iterm_map():
    """
    {tty: (window_id, tab_index)}. Vacio si iTerm no corre.

    Usa dos gets masivos en vez de recorrer sesion por sesion: resolver la ruta
    completa (`tty of session s of tab t of window w`) cuesta una llamada IPC por
    propiedad y tardaba 2.2s con 44 pestañas. Asi baja a ~0.5s.

    La lista plana de ttys viene en orden ventana > pestaña > sesion, y los conteos
    por ventana permiten reconstruir a que pestaña pertenece cada una. Verificado
    contra la version lenta: 44/44 identicas.
    """
    script = '''
    tell application "iTerm2"
      set AppleScript's text item delimiters to ","
      set r to ""
      repeat with w in windows
        set r to r & ((id of w) as text) & ":" & ((count of tabs of w) as text) & ","
      end repeat
      set tl to (tty of sessions of tabs of windows) as text
      set AppleScript's text item delimiters to ""
      return r & "@@@" & tl
    end tell
    '''
    try:
        out = subprocess.run(
            ["osascript", "-e", script], capture_output=True, text=True, timeout=15
        ).stdout.strip()
    except Exception:
        return {}
    if "@@@" not in out:
        return {}

    head, ttys = out.split("@@@", 1)
    wins = [p.split(":") for p in head.strip().rstrip(",").split(",") if ":" in p]
    # Validar la forma: si los text item delimiters fallaran, los ttys llegarian
    # concatenados ("/dev/ttys001/dev/ttys002") y produciriamos claves basura que
    # no casan con nada. Mejor descartarlas y que se vea el aviso "sin iTerm".
    tlist = [t for t in (x.strip() for x in ttys.split(",")) if TTY_RE.fullmatch(t)]

    result = {}
    i = 0
    for wid, count in wins:
        try:
            n = int(count)
        except ValueError:
            continue
        for tab in range(1, n + 1):
            if i >= len(tlist):
                break
            result[tlist[i].replace("/dev/", "")] = (wid.strip(), tab)
            i += 1
    return result


def read_transcript(session_id, cfg_dir=None):
    """
    Lee solo la cola del transcript. Todo campo es opcional.

    `cfg_dir` es el directorio de config de la cuenta duena de la sesion; sin el se
    buscaria siempre en ~/.claude y las sesiones de una segunda cuenta saldrian sin
    rama, modelo ni ultimo prompt.
    """
    info = {}
    base = cfg_dir or os.path.join(HOME, ".claude")
    hits = glob.glob(os.path.join(base, "projects", "*", f"{session_id}.jsonl"))
    if not hits:
        return info
    try:
        with open(hits[0], "rb") as fh:
            fh.seek(0, os.SEEK_END)
            size = fh.tell()
            fh.seek(max(0, size - TAIL_BYTES))
            chunk = fh.read().decode("utf-8", "ignore")
    except Exception:
        return info

    for line in chunk.split("\n"):
        line = line.strip()
        if not line:
            continue
        try:
            o = json.loads(line)
        except Exception:
            continue  # linea truncada por el corte de la cola
        if not isinstance(o, dict):
            continue
        for key, field in (("timestamp", "ts"), ("gitBranch", "branch"), ("effort", "effort")):
            if o.get(key):
                info[field] = o[key]
        if o.get("type") == "ai-title" and o.get("aiTitle"):
            info["title"] = o["aiTitle"]
        if o.get("type") == "last-prompt" and o.get("lastPrompt"):
            info["prompt"] = o["lastPrompt"]
        msg = o.get("message")
        if isinstance(msg, dict) and msg.get("model"):
            info["model"] = msg["model"]
    return info


# ─────────────────────────── numeracion estable ───────────────────────────


def assign_numbers(sessions):
    """sessionId -> numero fijo. Recicla los numeros de sesiones muertas."""
    try:
        with open(INDEX_FILE) as fh:
            index = json.load(fh)
    except Exception:
        index = {}

    live = {s["sessionId"] for s in sessions}
    index = {sid: n for sid, n in index.items() if sid in live}  # purgar muertas
    used = set(index.values())

    for s in sessions:
        sid = s["sessionId"]
        if sid not in index:
            n = 1
            while n in used:
                n += 1
            index[sid] = n
            used.add(n)

    try:
        os.makedirs(os.path.dirname(INDEX_FILE), exist_ok=True)
        with open(INDEX_FILE, "w") as fh:
            json.dump(index, fh, indent=2)
    except Exception:
        pass  # sin persistencia seguimos funcionando, solo pierde estabilidad

    return index


# ─────────────────────────────── formato ───────────────────────────────


def ago(iso_ts):
    """'hace 5m' / 'ayer 17:31' / '24-jul 21:52'."""
    if not iso_ts:
        return "?"
    try:
        dt = datetime.datetime.fromisoformat(iso_ts.replace("Z", "+00:00"))
        dt = dt.astimezone()
    except Exception:
        return "?"
    now = datetime.datetime.now(dt.tzinfo)
    delta = now - dt
    mins = delta.total_seconds() / 60
    if mins < 1:
        return "ahora"
    if mins < 60:
        return f"hace {int(mins)}m"
    if mins < 24 * 60 and now.date() == dt.date():
        return f"hace {int(mins / 60)}h"
    if (now.date() - dt.date()).days == 1:
        return f"ayer {dt.strftime('%H:%M')}"
    return dt.strftime("%d-%b %H:%M").lower()


def short_model(m):
    if not m:
        return None
    return m.replace("claude-", "").replace("-20", " ").split()[0]


def build(sessions, ttys, iterm, numbers):
    rows = []
    for s in sessions:
        info = read_transcript(s["sessionId"], s.get("_cfg"))
        tty = ttys.get(s["pid"], "")
        rows.append({
            "num": numbers[s["sessionId"]],
            "name": s["name"],
            "account": s.get("_account", ""),
            "repo": os.path.basename(s["cwd"]),
            "cwd": s["cwd"],
            "kind": s.get("kind", "interactive"),
            "status": s.get("status", "idle"),
            "sessionId": s["sessionId"],
            "pid": s["pid"],
            "tty": tty,
            "iterm": iterm.get(tty),
            "ts": info.get("ts"),
            "branch": info.get("branch"),
            "model": short_model(info.get("model")),
            "effort": info.get("effort"),
            "title": info.get("title"),
            "prompt": info.get("prompt"),
            "startedAt": s.get("startedAt", 0),
        })
    return rows


def sort_key(r):
    """Mas reciente primero. Sin timestamp -> al final, desempata por inicio."""
    return (r["ts"] or "", r["startedAt"])


def matches(row, query):
    """Coincidencia laxa: sin acentos, sin mayusculas, sobre nombre + repo + rama."""
    if not query:
        return True
    heno = strip_accents(" ".join(str(row.get(k) or "")
                                  for k in ("name", "repo", "branch", "account")).lower())
    return all(t in heno for t in strip_accents(query.lower()).split())


def strip_accents(s):
    return "".join(ch for ch in unicodedata.normalize("NFD", s)
                   if not unicodedata.combining(ch))


def multi_account(rows):
    """True si hay sesiones de mas de una cuenta: solo entonces vale la pena la columna."""
    return len({r.get("account", "") for r in rows}) > 1


def grouped(rows):
    """[(etiqueta, color, filas-ordenadas)] — grupos vacios se omiten."""
    out = [
        ("TRABAJANDO", GREEN, [r for r in rows if r["status"] == "busy"]),
        ("ESPERANDO", YELLOW, [r for r in rows
                               if r["status"] != "busy" and r["kind"] != "background"]),
    ]
    # Grupos de background: solo si existen de verdad
    bg = [r for r in rows if r["kind"] == "background" and r["status"] != "busy"]
    if bg:
        out.append(("BACKGROUND", CYAN, bg))
    return [(lbl, col, sorted(items, key=sort_key, reverse=True))
            for lbl, col, items in out if items]


def main_line(r, show_account=False):
    """Linea principal coloreada, con las columnas alineadas por ancho VISIBLE."""
    num = CYAN(BOLD(f"[{r['num']:>2}]"))
    name = pad(BOLD(r["name"][:36]), 38)
    repo = pad(MAGENTA(r["repo"][:15]), 17)
    # La cuenta solo se muestra si hay mas de una configurada: en el caso normal
    # seria una columna vacia en todas las filas.
    acct = pad(GREY(r.get("account") or ""), 11) if show_account else ""
    warn = RED(" ⚠") if not r["iterm"] else ""
    return f"{num} {name}{repo}{acct}{color_age(r['ts'])}{warn}"


def detail_line(r, width=None):
    """Rama · modelo · effort · ultimo prompt. Cada pieza con su color."""
    meta = [x for x in (GREY(r["branch"]) if r["branch"] else "",
                        color_model(r["model"]),
                        color_effort(r["effort"])) if x]
    out = DIM(" · ").join(meta)
    note = r["prompt"] or r["title"]
    if note:
        note = " ".join(str(note).split())
        quoted = DIM('"') + note + DIM('"')
        out = f"{out}{DIM(' · ')}{quoted}" if out else quoted
    return clip(out, width) if width else out


def render(rows):
    """Listado estatico de dos lineas por sesion (para --list y terminales sin TTY)."""
    width = (os.get_terminal_size().columns if sys.stdout.isatty() else 110)
    multi = multi_account(rows)
    print()
    for label, color, items in grouped(rows):
        print(color(BOLD(f"  {label} ({len(items)})")))
        print()
        for r in items:
            print("  " + main_line(r, multi))
            d = detail_line(r, width - 9)
            if d:
                print("       " + d)
        print()


# ───────────────────────── selector interactivo ─────────────────────────


def read_key(timeout=None):
    """
    Una pulsacion en modo raw. Devuelve 'up','down','enter','esc','q','r', un digito,
    o None si vencio el timeout (para poder refrescar sin bloquear).
    """
    fd = sys.stdin.fileno()
    old = termios.tcgetattr(fd)
    try:
        tty.setraw(fd)
        if timeout is not None and not select.select([fd], [], [], timeout)[0]:
            return None
        ch = os.read(fd, 1).decode("utf-8", "ignore")
        if ch == "\x1b":  # secuencia de escape: flechas o Esc suelto
            if not select.select([fd], [], [], 0.05)[0]:
                return "esc"
            rest = os.read(fd, 2).decode("utf-8", "ignore")
            return {"[A": "up", "[B": "down", "[5": "pgup", "[6": "pgdn"}.get(rest, "esc")
        if ch in ("\r", "\n"):
            return "enter"
        if ch in ("\x03", "\x04"):  # Ctrl-C / Ctrl-D
            return "q"
        if ch == "\x7f":
            return "back"
        return ch
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old)


class Feed:
    """Refresca las sesiones en segundo plano para que la interfaz no se congele."""

    def __init__(self, rows):
        self.rows = rows
        self.lock = threading.Lock()
        self.stamp = 0
        self.last_input = time.time()
        self._stop = threading.Event()
        self._wake = threading.Event()  # para forzar un refresco inmediato con 'r'
        self._t = threading.Thread(target=self._loop, daemon=True)
        self._t.start()

    def _loop(self):
        while not self._stop.is_set():
            # Cada refresco cuesta ~0.2s de CPU (claude agents + osascript). A 4s fijos
            # eso es ~5% de un nucleo indefinidamente, asi que si dejas el panel
            # abierto y sin tocar, se relaja hasta REFRESH_IDLE.
            idle = time.time() - self.last_input
            interval = REFRESH_SECONDS if idle < IDLE_AFTER else REFRESH_IDLE
            self._wake.wait(interval)
            self._wake.clear()
            if self._stop.is_set():
                return
            try:
                fresh = collect()
            except Exception:
                continue  # un fallo puntual no debe tumbar el panel
            with self.lock:
                self.rows = fresh
                self.stamp += 1

    def touch(self):
        """El usuario interactuo: volver al refresco rapido."""
        self.last_input = time.time()

    def snapshot(self):
        with self.lock:
            return self.rows, self.stamp

    def force(self):
        self._wake.set()

    def stop(self):
        self._stop.set()
        self._wake.set()


def build_display(rows, width=100):
    """
    Lista plana de (rol, texto, fila). Roles:
      'head'   cabecera de grupo, no seleccionable
      'main'   linea principal de una sesion — es la seleccionable
      'sub'    linea de detalle, se resalta junto a su 'main'
      'blank'  separador
    """
    lines = []
    multi = multi_account(rows)
    for label, color, items in grouped(rows):
        lines.append(("head", color(BOLD(f"{label} ({len(items)})")), None))
        for r in items:
            lines.append(("main", main_line(r, multi), r))
            d = detail_line(r, width - 9)
            if d:
                lines.append(("sub", d, r))
        lines.append(("blank", "", None))
    return lines


def interactive(feed):
    """
    Panel vivo: flechas o numero para elegir, Enter para saltar a la ventana.
    NO se cierra al saltar — sigue abierto y refrescandose hasta que pulses esc/q.
    """
    cols0 = os.get_terminal_size().columns if sys.stdout.isatty() else 100
    rows, stamp = feed.snapshot()
    lines = build_display(rows, cols0)  # query vacia al arrancar
    pickable = [i for i, (role, _, _) in enumerate(lines) if role == "main"]
    sel_id = lines[pickable[0]][2]["sessionId"] if pickable else None
    typed, top, flash, query = "", 0, "", ""
    last_cols = cols0
    dirty = True    # solo repintar cuando algo cambia: evita quemar CPU a 2.5 fps
    requery = False  # fuerza reconstruir la vista tras tocar el filtro

    sys.stdout.write("\033[?1049h\033[?25l")  # pantalla alternativa, sin cursor
    try:
        while True:
            fresh, new_stamp = feed.snapshot()
            now_cols = os.get_terminal_size().columns
            if new_stamp != stamp or now_cols != last_cols or requery:
                stamp, rows, last_cols, requery = new_stamp, fresh, now_cols, False
                shown = [r for r in rows if matches(r, query)]
                lines = build_display(shown, now_cols)
                pickable = [i for i, (role, _, _) in enumerate(lines) if role == "main"]
                if pickable and not any(lines[i][2]["sessionId"] == sel_id for i in pickable):
                    sel_id = lines[pickable[0]][2]["sessionId"]  # el filtro dejo fuera al cursor
                dirty = True

            if not pickable:
                if query:
                    # hay sesiones, solo que ninguna casa: hay que poder seguir
                    # editando el filtro, no solo salir
                    msg = ("  " + DIM("filtro: ") + CYAN(BOLD(query)) + "  "
                           + RED("sin resultados") + DIM("  ⌫ borra · esc limpia"))
                else:
                    msg = "  " + DIM("Sin sesiones activas. esc para salir")
                sys.stdout.write("\033[H\033[2J" + msg + "\r\n")
                sys.stdout.flush()
                k = read_key(1.0)
                if k is None:
                    continue
                if k == "esc":
                    if query:
                        query, requery, top = "", True, 0
                        continue
                    return
                if k == "q" and not query:
                    return
                if k == "back" and query:
                    query, requery, top = query[:-1], True, 0
                elif len(k) == 1 and k.isprintable():
                    query, requery, top = query + k, True, 0
                continue

            # el cursor sigue a la MISMA sesion aunque la lista se reordene
            cur = next((i for i, li in enumerate(pickable)
                        if lines[li][2]["sessionId"] == sel_id), 0)
            by_num = {r["num"]: r for r in rows}

            cols, term_rows = os.get_terminal_size()
            body = max(5, term_rows - 6)
            cl = pickable[cur]
            # +1 para que la linea de detalle de la fila elegida no quede cortada abajo
            has_sub = cl + 1 < len(lines) and lines[cl + 1][0] == "sub"
            bottom_need = cl + (1 if has_sub else 0)
            new_top = top
            if cl < new_top:
                new_top = cl
            elif bottom_need >= new_top + body:
                new_top = bottom_need - body + 1
            new_top = max(0, min(new_top, max(0, len(lines) - body)))
            if new_top != top:
                top, dirty = new_top, True

            if dirty:
                sel_row = lines[cl][2]
                buf = ["\033[H\033[2J"]
                busy_n = sum(1 for r in rows if r["status"] == "busy")
                more = DIM(" ↕") if len(lines) > body else ""
                head = (DIM("  ") + BOLD(str(len(rows))) + DIM(" sesiones · ")
                        + GREEN(f"{busy_n} activas") + more)
                buf.append(head + ("   " + GREEN(flash) if flash else "") + "\r\n")

                # Cabecera de grupo fija: en ventanas pequeñas el scroll se lleva la
                # cabecera por arriba y pierdes de vista en que grupo estas.
                group_i = max((j for j in range(cl, -1, -1)
                               if lines[j][0] == "head"), default=None)
                if group_i is not None and group_i < top:
                    buf.append(" " + lines[group_i][1] + DIM(" …") + "\r\n")
                    body -= 1

                for i in range(top, min(top + body, len(lines))):
                    role, text, row = lines[i]
                    # la fila resaltada abarca sus DOS lineas (principal + detalle)
                    on_cur = row is not None and row is sel_row and role in ("main", "sub")
                    if on_cur:
                        bar = CYAN("▌")
                        body_txt = clip(text, cols - 4)
                        pref = " " if role == "main" else "   "
                        buf.append(f"{bar}{pref}{body_txt}\r\n")
                    elif role == "main":
                        buf.append(" " + clip(text, cols - 4) + "\r\n")
                    elif role == "sub":
                        buf.append("     " + clip(text, cols - 7) + "\r\n")
                    elif role == "head":
                        buf.append(" " + text + "\r\n")
                    else:
                        buf.append("\r\n")

                hint = (DIM("↑↓") + " mover  " + DIM("enter") + " abrir  "
                        + DIM("nº") + " ir  " + DIM("escribe") + " filtrar  "
                        + DIM("esc") + " salir")
                if typed:
                    nm = by_num.get(int(typed))
                    hint = (CYAN(BOLD(f"→ [{typed}] {nm['name']}")) if nm
                            else RED(f"[{typed}] no existe")) + DIM("  enter confirma · ⌫ borra")
                elif query:
                    n = len(pickable)
                    cuenta = (GREEN(f"{n} coincide" + ("n" if n != 1 else ""))
                              if n else RED("sin resultados"))
                    hint = (DIM("filtro: ") + CYAN(BOLD(query)) + "  " + cuenta
                            + DIM("  ⌫ borra · esc limpia"))
                buf.append("\r\n " + hint + "\r\n")

                sys.stdout.write("".join(buf))
                sys.stdout.flush()
                dirty = False

            k = read_key(timeout=0.4)  # corto: detecta el refresco de fondo sin frenar teclas
            if k is None:
                continue
            dirty = True   # cualquier tecla cambia algo que hay que repintar
            feed.touch()   # vuelve al refresco rapido
            flash = ""
            if k == "esc":
                # esc limpia el filtro antes de salir: perder el filtro por accidente
                # es mas molesto que tener que pulsar esc dos veces
                if query:
                    query, requery, top = "", True, 0
                else:
                    return
            elif k == "q" and not query:
                return  # con filtro activo, 'q' es texto que se busca
            elif k == "up":
                sel_id = lines[pickable[(cur - 1) % len(pickable)]][2]["sessionId"]; typed = ""
            elif k == "down":
                sel_id = lines[pickable[(cur + 1) % len(pickable)]][2]["sessionId"]; typed = ""
            elif k == "pgup":
                sel_id = lines[pickable[max(0, cur - body // 2)]][2]["sessionId"]; typed = ""
            elif k == "pgdn":
                i = min(len(pickable) - 1, cur + body // 2)
                sel_id = lines[pickable[i]][2]["sessionId"]; typed = ""
            elif k == "back":
                if typed:
                    typed = typed[:-1]
                elif query:
                    query, requery, top = query[:-1], True, 0
            elif k == "r" and not query and not typed:
                feed.force()
                flash = "actualizando…"
            elif k.isdigit() and not query:
                # los digitos son seleccion... salvo si ya estas filtrando, donde
                # forman parte del texto buscado (p.ej. "v5", "0042")
                cand = typed + k
                if any(str(n).startswith(cand) for n in by_num):
                    typed = cand
                elif int(k) in by_num:
                    typed = k
            elif len(k) == 1 and k.isprintable():
                query, requery, top, typed = query + k, True, 0, ""
            elif k == "enter":
                target = None
                if typed:
                    target = by_num.get(int(typed))
                    typed = ""
                else:
                    target = lines[cl][2]
                if target:
                    sel_id = target["sessionId"]
                    ok = focus(target, quiet=True)
                    flash = (f"→ {target['name']}" if ok == 0
                             else f"⚠ {target['name']} no está en iTerm")
    finally:
        sys.stdout.write("\033[?25h\033[?1049l")  # restaurar cursor y pantalla
        sys.stdout.flush()


# ─────────────────────────────── enfoque ───────────────────────────────


def focus(row, quiet=False):
    if not row["iterm"]:
        if not quiet:
            print(f"La sesion [{row['num']}] {row['name']} no esta en iTerm "
                  f"(tty={row['tty'] or 'proceso muerto'}).", file=sys.stderr)
            print(f"  cwd: {row['cwd']}", file=sys.stderr)
        return 1
    wid, tab = row["iterm"]
    script = f'''
    tell application "iTerm2"
      tell window id {wid} to select tab {tab}
      select window id {wid}
      activate
    end tell
    '''
    res = subprocess.run(["osascript", "-e", script], capture_output=True, text=True)
    if res.returncode != 0:
        if not quiet:
            print(f"No se pudo enfocar: {res.stderr.strip()}", file=sys.stderr)
        return 1
    if not quiet:
        print(f"→ {row['name']} ({row['repo']})")
    return 0


# ─────────────────────────────── main ───────────────────────────────


def collect():
    """Una foto completa del estado. iTerm y `claude agents` van en paralelo (~0.4s menos)."""
    with ThreadPoolExecutor(max_workers=2) as pool:
        iterm_future = pool.submit(get_iterm_map)
        sessions = get_sessions()
        if not sessions:
            iterm_future.cancel()
            return []
        numbers = assign_numbers(sessions)
        ttys = get_ttys([s["pid"] for s in sessions])
        iterm = iterm_future.result()
    return build(sessions, ttys, iterm, numbers)


def main():
    args = sys.argv[1:]
    only_list = "--list" in args or "-l" in args
    direct = next((a for a in args if a.isdigit()), None)

    try:
        rows = collect()
    except SessionsUnavailable as e:
        print(f"ccl: {e}", file=sys.stderr)
        return 1

    if not rows:
        print("No hay sesiones de Claude Code activas.")
        return 0

    if direct:
        row = next((r for r in rows if r["num"] == int(direct)), None)
        if not row:
            print(f"No existe la sesion numero {direct}.", file=sys.stderr)
            return 1
        return focus(row)

    # Sin TTY (pipe, script) o --list: salida estatica, sin interaccion
    if only_list or not sys.stdin.isatty() or not sys.stdout.isatty():
        render(rows)
        return 0

    feed = Feed(rows)
    try:
        interactive(feed)
    finally:
        feed.stop()
    return 0


if __name__ == "__main__":
    sys.exit(main())
