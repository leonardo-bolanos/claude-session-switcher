def t(clave, **campos):
    """
    El texto de `clave` en el idioma activo, con los huecos rellenos.

    Cae al ingles si falta una traduccion: preferible una linea en otro idioma a un
    KeyError que tumbe el panel. El test `test_los_dos_idiomas_tienen_las_mismas_claves`
    existe para que ese caso no llegue a pasar.
    """
    plantilla = TEXTOS.get(LANG, TEXTOS["en"]).get(clave) or TEXTOS["en"][clave]
    return plantilla.format(**campos) if campos else plantilla


