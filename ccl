def help_secciones():
    """La ayuda del idioma activo."""
    return HELP_ES if LANG == "es" else HELP_EN


def help_lines(cols):
    """Las lineas de la ayuda, sin paginar ni terminadores."""
    out = [" " + CYAN(BOLD("ccl")) + DIM(t("ayuda_titulo")), ""]
    for titulo, filas in help_secciones():
        out.append(" " + YELLOW(BOLD(titulo)))
        for tecla, desc in filas:
            k = pad(CYAN(tecla) if tecla else "", 18)
            out.append("   " + k + clip(DIM(desc) if not tecla else desc, cols - 24))
        out.append("")
    return out


def help_pages(cols, term_rows):
    """
    La ayuda partida en paginas que caben en la ventana.

    Hace falta porque la ayuda ya no cabe en una pantalla normal: se pinta de arriba
    abajo, asi que sin paginar lo que sobra se va por el borde SUPERIOR y se pierde el
    principio, sin ningun aviso de que faltaba algo.
    """
    cuerpo = max(3, term_rows - 2)   # una fila para el pie, otra de margen: sin margen
    lineas = help_lines(cols)        # el salto final hace scroll y se come la primera
    if len(lineas) <= cuerpo:
        return [lineas]

    paginas, resto = [], lineas
    while resto:
        if len(resto) <= cuerpo:
            paginas.append(resto)
            break
        # Cortar al final de una seccion (linea en blanco), no en la fila exacta donde
        # se acaba el hueco: partiendo a ciegas, la pagina siguiente empieza por una
        # linea de nota sin su tecla ni su titulo, y se lee como texto colgando.
        corte = cuerpo
        while corte > 1 and resto[corte - 1] != "":
            corte -= 1
        if corte <= 1:               # una seccion mas alta que la ventana: partirla igual
            corte = cuerpo
        paginas.append(resto[:corte])
        resto = resto[corte:]
    return paginas


def render_help(cols, term_rows, pagina=0, paginas=None):
    """
    Una pagina de la ayuda. La barra de abajo solo lleva lo imprescindible.

    `paginas` se puede pasar ya calculado para no repaginar en cada pulsacion mientras
    el usuario hojea.
    """
    paginas = paginas if paginas is not None else help_pages(cols, term_rows)
    pagina = max(0, min(pagina, len(paginas) - 1))
    buf = ["\033[H\033[2J"]
    buf.extend(linea + "\r\n" for linea in paginas[pagina])
    if len(paginas) == 1:
        buf.append(" " + DIM(t("ayuda_volver")) + "\r\n")
    elif pagina + 1 < len(paginas):
        buf.append(" " + DIM(t("ayuda_pagina", i=pagina + 1, n=len(paginas)))
                   + CYAN(t("tecla_espacio"))
                   + DIM(t("ayuda_sigue")) + "\r\n")
    else:
        # en la ultima no hay "siguiente": ofrecer espacio ahi seria mentira, el espacio
        # vuelve al panel como cualquier otra tecla
        buf.append(" " + DIM(t("ayuda_pagina", i=pagina + 1, n=len(paginas)))
                   + DIM(t("ayuda_vuelve")) + "\r\n")
    return "".join(buf)


def build_display(rows, width=100):
    """
    Lista plana de (rol, texto, fila). Roles:
      'head'   cabecera de grupo, no seleccionable
      'main'   linea principal de una sesion — es la seleccionable
      'sub'    linea de detalle, se resalta junto a su 'main'
      'blank'  separador
    """
    lines = []
    multi = multi_account(rows)
    for label, color, items in grouped(rows):
        lines.append(("head", color(BOLD(f"{label} ({len(items)})")), None))
        for r in items:
            lines.append(("main", main_line(r, multi), r))
            d = detail_line(r, width - 9)
            if d:
                lines.append(("sub", d, r))
        lines.append(("blank", "", None))
    return lines


def build_table_display(rows, width=100):
    """
    Lo mismo que `build_display`, en tabla: cabecera de columnas y una linea por sesion.

    Devuelve los MISMOS roles a proposito. Asi el cursor, el clic, el scroll y la
    cabecera fija siguen funcionando sin enterarse de que vista esta puesta: la unica
    diferencia entre las dos vistas es la lista de lineas que produce cada una.
    """
    # -4: es lo que el panel deja para el margen y la barra del cursor (pinta cada fila
    # como `clip(texto, cols - 4)`). Construyendo a `width` a secas, el recorte de pintar
    # se comia la ultima columna y la cabecera, que NO se recorta, se salia una posicion.
    ancho = max(40, width - 4)
    multi = multi_account(rows)
    lines = [("head", table_head(ancho, multi), None)]
    for _, _, items in grouped(rows):
        for r in items:
            lines.append(("main", table_line(r, ancho, multi), r))
    return lines


def vista(rows, width, tabla):
    """El constructor de lineas que toca segun la vista activa."""
    return build_table_display(rows, width) if tabla else build_display(rows, width)


def interactive(feed, tabla=False):
    """
    Panel vivo: flechas, numero o clic para elegir; Enter o doble clic para saltar.
    NO se cierra al saltar — sigue abierto y refrescandose hasta que pulses esc/q.
    """
    cols0 = os.get_terminal_size().columns if sys.stdout.isatty() else 100
    rows, stamp = feed.snapshot()
    lines = vista(rows, cols0, tabla)  # query vacia al arrancar
    pickable = [i for i, (role, _, _) in enumerate(lines) if role == "main"]
    sel_id = lines[pickable[0]][2]["sessionId"] if pickable else None
    typed, top, flash, query = "", 0, "", ""
    # El editor recuerda a QUE SESION pertenece la nota, no en que fila estaba. `lines[cl]`
    # se resuelve en cada vuelta del bucle: si la sesion que estabas anotando muere y el
    # refresco reordena la lista, esa fila pasa a ser OTRA sesion y el Enter guardaba el
    # texto en la equivocada — el mismo fallo que ya se corrigio para el contagio de notas,
    # por otro camino.
    editando = None       # None = no estas escribiendo; un str = el texto en curso
    editando_sid = None   # la sesion a la que pertenece ese texto
    editando_repo = ""    # su repo, para el prompt
    aviso_salto = ""      # el resultado de un ⌥N pulsado con la lista vacia por el filtro
    # Ctrl-O cambia la fuente de las filas: en vez de las vivas que trae el `Feed`, las
    # recuperables que se leen de disco. Se guardan aparte porque el Feed sigue
    # refrescando por detras y machacaria la lista al segundo siguiente.
    modo_recent = False
    filas_recent = []
    last_cols = cols0
    dirty = True    # solo repintar cuando algo cambia: evita quemar CPU a 2.5 fps
    requery = False  # fuerza reconstruir la vista tras tocar el filtro
    screen = {}     # fila de la terminal -> indice en `lines`, para saber donde se hizo clic
    last_click = (0, 0.0)   # (fila, momento) del ultimo clic, para detectar el doble

    # El raton se puede desactivar: mientras esta activo, iTerm2 le pasa los clics al
    # programa y pierdes la seleccion de texto normal dentro del panel (con ⌥ pulsado
    # se puede seleccionar igual, pero a quien le moleste le sobra con CCL_MOUSE=0).
    mouse = os.environ.get("CCL_MOUSE", "1") != "0"
    attrs_previos = _sin_tecla_status()
    sys.stdout.write("\033[?1049h\033[?25l")  # pantalla alternativa, sin cursor
    if mouse:
        sys.stdout.write(MOUSE_ON)
    try:
        while True:
            fresh, new_stamp = feed.snapshot()
            now_cols = os.get_terminal_size().columns
            if new_stamp != stamp or now_cols != last_cols or requery:
                stamp, last_cols, requery = new_stamp, now_cols, False
                rows = filas_recent if modo_recent else fresh
                shown = [r for r in rows if matches(r, query)]
                lines = vista(shown, now_cols, tabla)
                pickable = [i for i, (role, _, _) in enumerate(lines) if role == "main"]
                if pickable and not any(lines[i][2]["sessionId"] == sel_id for i in pickable):
                    sel_id = lines[pickable[0]][2]["sessionId"]  # el filtro dejo fuera al cursor
                # Si la sesion que estabas anotando ya no existe, se cancela la edicion. Sin
                # esto el texto se quedaba en curso mientras el cursor saltaba a otra fila, y
                # el Enter lo guardaba en una sesion que no era la tuya.
                if editando is not None and not any(r["sessionId"] == editando_sid
                                                    for r in rows):
                    editando, flash = None, t("nota_perdida")
                dirty = True

            if not pickable:
                # Aqui no hay fila sobre la que anotar, asi que se sale del editor. Sin
                # esto, si el filtro (o la muerte de la ultima sesion) deja la lista
                # vacia mientras escribes, `editando` se queda con el texto viejo y el
                # editor reaparece solo cuando vuelva a haber filas.
                editando = None
                if query:
                    # hay sesiones, solo que ninguna casa: hay que poder seguir
                    # editando el filtro, no solo salir
                    msg = ("  " + DIM(t("filtro")) + CYAN(BOLD(query)) + "  "
                           + RED(t("sin_resultados")) + DIM(t("borra_limpia")))
                else:
                    msg = "  " + DIM(t("sin_sesiones_esc"))
                if aviso_salto:
                    msg += "\r\n  " + GREEN(aviso_salto)
                sys.stdout.write("\033[H\033[2J" + msg + "\r\n")
                sys.stdout.flush()
                k = read_key(1.0)
                if k is None:
                    continue
                if k == "esc":
                    if query:
                        query, requery, top = "", True, 0
                        continue
                    return
                if k == "q" and not query:
                    return
                if k.startswith("alt-"):
                    # tiene que funcionar tambien aqui: es justo el caso "escribi mal
                    # el filtro, llevame a la que me espera". Y el aviso se MUESTRA: al
                    # tirarlo, un "solo hay N esperando" desaparecia y parecia que la
                    # tecla no habia hecho nada.
                    nuevo_sel, aviso_salto = jump_waiting(rows, int(k[4:]))
                    if nuevo_sel:
                        sel_id = nuevo_sel
                elif k == "back" and query:
                    query, requery, top = query[:-1], True, 0
                elif len(k) == 1 and k.isprintable():
                    query, requery, top = query + k, True, 0
                continue

            # el cursor sigue a la MISMA sesion aunque la lista se reordene
            cur = next((i for i, li in enumerate(pickable)
                        if lines[li][2]["sessionId"] == sel_id), 0)
            by_num = {r["num"]: r for r in rows}

            cols, term_rows = os.get_terminal_size()
            body = max(5, term_rows - 6)
            cl = pickable[cur]
            # +1 para que la linea de detalle de la fila elegida no quede cortada abajo
            has_sub = cl + 1 < len(lines) and lines[cl + 1][0] == "sub"
            bottom_need = cl + (1 if has_sub else 0)
            new_top = top
            if cl < new_top:
                new_top = cl
            elif bottom_need >= new_top + body:
                new_top = bottom_need - body + 1
            new_top = max(0, min(new_top, max(0, len(lines) - body)))
            if new_top != top:
                top, dirty = new_top, True

            if dirty:
                sel_row = lines[cl][2]
                # El raton se REARMA en cada repintado, no solo al arrancar. Cualquier cosa
                # que resetee los modos privados del terminal —tmux, un `reset` de otro
                # programa, iTerm restaurando la sesion— apagaba el reporte de clics para
                # siempre: el panel seguia vivo y los clics dejaban de hacer nada, sin
                # ningun sintoma que apuntara al terminal. Son 16 bytes, es idempotente, y
                # como el refresco de fondo marca `dirty` cada 4-20 s, se cura solo.
                buf = [MOUSE_ON if mouse else "", "\033[H\033[2J"]
                # El mapa fila-de-terminal -> linea se construye AQUI, pintando, no
                # calculando: cualquier cosa que se añada arriba (cabecera de grupo fija,
                # un aviso) desplaza todo, y un calculo aparte se desincronizaria en
                # silencio, mandando el clic a la sesion vecina.
                screen = {}
                y = 1
                busy_n = sum(1 for r in rows if r["status"] == "busy")
                more = DIM(" ↕") if len(lines) > body else ""
                if modo_recent:
                    head = (DIM("  ") + BOLD(str(len(rows)))
                            + DIM(t("cabecera_recent")) + more)
                else:
                    head = (DIM("  ") + BOLD(str(len(rows))) + DIM(t("cabecera"))
                            + GREEN(t("activas", n=busy_n)) + more)
                buf.append(head + ("   " + GREEN(flash) if flash else "") + "\r\n")
                y += 1

                # Cabecera de grupo fija: en ventanas pequeñas el scroll se lleva la
                # cabecera por arriba y pierdes de vista en que grupo estas.
                group_i = max((j for j in range(cl, -1, -1)
                               if lines[j][0] == "head"), default=None)
                if group_i is not None and group_i < top:
                    buf.append(" " + lines[group_i][1] + DIM(" …") + "\r\n")
                    body -= 1
                    y += 1

                for i in range(top, min(top + body, len(lines))):
                    role, text, row = lines[i]
                    screen[y] = i
                    y += 1
                    # la fila resaltada abarca sus DOS lineas (principal + detalle)
                    on_cur = row is not None and row is sel_row and role in ("main", "sub")
                    if on_cur:
                        # La barra ▌ se queda ademas del fondo: es lo unico que marca la
                        # fila en un terminal sin 256 colores, y con CCL_CURSOR_BG=0.
                        bar = CYAN("▌")
                        body_txt = clip(text, cols - 4)
                        pref = " " if role == "main" else "   "
                        buf.append(bar + con_fondo(pref + body_txt, cols - 2) + "\r\n")
                    elif role == "main":
                        buf.append(" " + clip(text, cols - 4) + "\r\n")
                    elif role == "sub":
                        buf.append("     " + clip(text, cols - 7) + "\r\n")
                    elif role == "head":
                        buf.append(" " + text + "\r\n")
                    else:
                        buf.append("\r\n")

                # Se recorta al ancho: con seis atajos la barra ya no cabe en una
                # ventana estrecha, y al envolverse empujaba el panel una linea hacia
                # arriba en cada repintado.
                hint = clip(DIM("↑↓") + t("barra_mover") + DIM("enter") + t("barra_abrir")
                            + CYAN("⌥1-9") + DIM(t("barra_esperando"))
                            + CYAN("^N") + DIM(t("barra_nota"))
                            + CYAN("^P") + DIM(t("barra_pausa"))
                            + CYAN("^T") + DIM(t("barra_tabla"))
                            + CYAN("^O") + DIM(t("barra_volver" if modo_recent
                                                 else "barra_recuperables"))
                            + DIM(t("barra_escribe")) + t("barra_filtrar")
                            + CYAN("?") + DIM(t("barra_ayuda")), cols - 2)
                if editando is not None:
                    # el cursor ▏ hace falta: sin el, una nota vacia no se distingue de
                    # "no estoy en modo edicion" y parece que la tecla no hizo nada
                    hint = (DIM(t("nota_prompt", repo=editando_repo))
                            + CYAN(BOLD(editando)) + CYAN("▏")
                            + DIM(t("nota_teclas")))
                elif typed:
                    nm = by_num.get(int(typed))
                    hint = (CYAN(BOLD(t("va_a", n=typed, name=nm["name"]))) if nm
                            else RED(t("no_existe", n=typed))) + DIM(t("enter_confirma"))
                elif query:
                    n = len(pickable)
                    cuenta = (GREEN(t("coincide" if n == 1 else "coinciden", n=n))
                              if n else RED(t("sin_resultados")))
                    hint = (DIM(t("filtro")) + CYAN(BOLD(query)) + "  " + cuenta
                            + DIM(t("borra_limpia")))
                buf.append("\r\n " + hint + "\r\n")

                sys.stdout.write("".join(buf))
                sys.stdout.flush()
                dirty = False

            k = read_key(timeout=0.4)  # corto: detecta el refresco de fondo sin frenar teclas
            if k is None:
                continue
            if k.startswith("mouse-"):
                continue   # soltar el boton, o un boton que no usamos: ni repintar
            if not mouse and (k.startswith("click:") or k in ("wheelup", "wheeldn")):
                continue   # CCL_MOUSE=0 significa sin raton, aunque algo los mande igual
            dirty = True   # cualquier tecla cambia algo que hay que repintar
            feed.touch()   # vuelve al refresco rapido
            flash = ""

            # Escribiendo una nota, el teclado es del editor: va PRIMERO, o 'q' saldria
            # del panel y los digitos harian de selector en medio de la frase.
            if editando is not None:
                if k == "enter":
                    save_note(editando_sid, editando)
                    # Aplicarla ya en memoria: si no, no se ve hasta el refresco (4 s) y
                    # parece que no se guardo. Se recalcula con `note_for` en vez de meter
                    # el texto tal cual, para que al borrar la propia reaparezca la del
                    # repo en el mismo instante.
                    notas_sesion, notas_repo = load_notes()
                    for r in rows:
                        if r["sessionId"] == editando_sid:
                            r["note"] = note_for(r, notas_sesion, notas_repo)
                    flash = t("nota_guardada") if editando.strip() else t("nota_borrada")
                    editando, requery = None, True
                elif k == "esc":
                    editando, flash = None, t("nota_sin_cambios")
                elif k == "back":
                    editando = editando[:-1]
                elif len(k) == 1 and k.isprintable():
                    editando = (editando + k)[:NOTE_MAX]
                continue

            if k == "esc":
                # esc limpia el filtro antes de salir: perder el filtro por accidente
                # es mas molesto que tener que pulsar esc dos veces
                if query:
                    query, requery, top = "", True, 0
                else:
                    return
            elif k == "q" and not query:
                return  # con filtro activo, 'q' es texto que se busca
            elif k == "up":
                sel_id = lines[pickable[(cur - 1) % len(pickable)]][2]["sessionId"]; typed = ""
            elif k == "down":
                sel_id = lines[pickable[(cur + 1) % len(pickable)]][2]["sessionId"]; typed = ""
            elif k == "pgup":
                sel_id = lines[pickable[max(0, cur - body // 2)]][2]["sessionId"]; typed = ""
            elif k == "pgdn":
                i = min(len(pickable) - 1, cur + body // 2)
                sel_id = lines[pickable[i]][2]["sessionId"]; typed = ""
            elif k == "back":
                if typed:
                    typed = typed[:-1]
                elif query:
                    query, requery, top = query[:-1], True, 0
            elif k == "?" and not query:
                # las paginas se calculan UNA vez: `render_help` las recibe hechas en vez
                # de reconstruir las 33 filas en cada pulsacion
                paginas = help_pages(cols, term_rows)
                pagina = 0
                while True:
                    sys.stdout.write(render_help(cols, term_rows, pagina, paginas))
                    sys.stdout.flush()
                    tecla = read_key()
                    if tecla == " " and pagina + 1 < len(paginas):
                        pagina += 1
                        continue
                    break               # cualquier otra tecla vuelve al panel
                dirty = True
            elif k == "note":
                # Ctrl-N, por lo mismo que Ctrl-R: una letra suelta se comeria el filtro.
                # Arranca con la nota que ya hubiera, para poder corregirla en vez de
                # tener que reescribirla entera.
                objetivo = lines[cl][2]
                editando = objetivo.get("note") or ""
                editando_sid = objetivo["sessionId"]
                editando_repo = os.path.basename(objetivo["cwd"])
            elif k == "pause":
                # Ctrl-P: esta sesion espera a otro, no a mi. Se aplica YA en memoria por
                # lo mismo que la nota: hasta el refresco siguiente (4 s) no se movería de
                # grupo y parecería que la tecla no hizo nada.
                objetivo = lines[cl][2]
                en_pausa = toggle_paused(objetivo["sessionId"])
                for r in rows:
                    if r["sessionId"] == objetivo["sessionId"]:
                        r["paused"] = en_pausa
                flash = t("pausada" if en_pausa else "reanudada", name=objetivo["name"])
                requery = True
            elif k == "recuperables":
                # Ctrl-O: las que murieron con su terminal, leidas de disco. Cuesta ~0,4 s
                # (lee la cola de hasta 60 transcripts), asi que se hace al pulsar y no en
                # cada refresco.
                modo_recent = not modo_recent
                if modo_recent:
                    filas_recent = recent_rows()
                    if not filas_recent:
                        modo_recent, flash = False, t("sin_recuperables")
                    else:
                        # el cursor tiene que saltar a la lista nueva: su sessionId de
                        # antes no existe aqui, y quedaria apuntando a nada
                        sel_id = filas_recent[0]["sessionId"]
                        flash = t("modo_recent", n=len(filas_recent))
                else:
                    flash = t("modo_vivas")
                # el filtro y el numero a medio teclear son de la otra lista
                query, typed, top, requery = "", "", 0, True
            elif k == "table":
                # Ctrl-T: la misma lista en columnas. El cursor sigue al sessionId, asi
                # que cambiar de vista no lo mueve de sesion.
                tabla, requery = not tabla, True
            elif k == "refresh":
                # Ctrl-R, no 'r' a secas: cualquier letra empieza a filtrar, y 'r' se
                # comia el filtrado de todo lo que empezara por esa letra
                feed.force()
                flash = t("actualizando")
            elif k == "wheelup":
                sel_id = lines[pickable[max(0, cur - 1)]][2]["sessionId"]; typed = ""
            elif k == "wheeldn":
                i = min(len(pickable) - 1, cur + 1)
                sel_id = lines[pickable[i]][2]["sessionId"]; typed = ""
            elif k.startswith("click:"):
                # El terminal NO reporta dobles clics, solo clics sueltos: el doble hay
                # que sintetizarlo por tiempo y fila. Simple selecciona, doble abre.
                fila_y = int(k[6:])
                idx = screen.get(fila_y)
                tocada = (lines[idx][2] if idx is not None
                          and lines[idx][0] in ("main", "sub") else None)
                ahora = time.time()
                doble = (tocada is not None and last_click[0] == fila_y
                         and ahora - last_click[1] < DOUBLE_CLICK)
                last_click = (fila_y, ahora)
                if tocada is None:
                    dirty = False   # cabecera o hueco: no hay nada que elegir ni repintar
                elif doble:
                    sel_id = tocada["sessionId"]
                    flash = abrir(tocada, f"→ {tocada['name']}")
                    # que un triple clic no cuente como un segundo doble
                    last_click = (0, 0.0)
                else:
                    sel_id, typed = tocada["sessionId"], ""
            elif k.startswith("alt-"):
                # Option-N: salta a la N-esima ESPERANDO. Cuenta sobre `rows` (la lista
                # completa), no sobre las filtradas: el sentido de la tecla es "sacame
                # de aqui hacia la que me espera", y dependiendo del filtro cambiaria
                # a que sesion va el mismo numero.
                nuevo_sel, flash = jump_waiting(rows, int(k[4:]))
                if nuevo_sel:
                    sel_id = nuevo_sel
                # `typed` se limpia igual que en las flechas y el clic: si no, un numero a
                # medio teclear seguia teniendo prioridad y el Enter siguiente enfocaba ESE
                # numero en vez de la sesion a la que acabas de saltar.
                typed = ""
            elif k.isdigit() and not query:
                # los digitos son seleccion... salvo si ya estas filtrando, donde
                # forman parte del texto buscado (p.ej. "v5", "0042")
                cand = typed + k
                if any(str(n).startswith(cand) for n in by_num):
                    typed = cand
                elif int(k) in by_num:
                    typed = k
            elif len(k) == 1 and k.isprintable():
                query, requery, top, typed = query + k, True, 0, ""
            elif k == "enter":
                target = None
                if typed:
                    target = by_num.get(int(typed))
                    typed = ""
                else:
                    target = lines[cl][2]
                if target:
                    sel_id = target["sessionId"]
                    flash = abrir(target, f"→ {target['name']}")
    finally:
        # apagar el raton ANTES de soltar la pantalla alternativa: si se queda activo,
        # la terminal sigue mandando escapes por cada clic y el shell los ve como texto
        if mouse:
            sys.stdout.write(MOUSE_OFF)
        sys.stdout.write("\033[?25h\033[?1049l")  # restaurar cursor y pantalla
        sys.stdout.flush()
        _restaurar_tty(attrs_previos)


# ─────────────────────────────── enfoque ───────────────────────────────


def focus(row, quiet=False):
    if row.get("tmux"):
        destino, sesion = row["tmux"]
        # Seleccionar el panel SIEMPRE, este enganchada la sesion o no: si esta suelta, se
        # engancha justo despues y ya aparece en el panel correcto.
        _tmux("select-window", "-t", destino.rsplit(".", 1)[0])
        _tmux("select-pane", "-t", destino)
        if not row["ventana"]:
            # tmux vivo pero sin cliente: es el caso de "se cayo iTerm y tmux aguanto".
            # Se engancha en una pestaña nueva en vez de decir que no se encuentra.
            if pestaña_nueva("tmux attach -t " + shlex.quote(sesion), quiet,
                             row.get("space")) != 0:
                return 1
            if not quiet:
                print(t("enganchada", name=row["name"], sesion=sesion))
            return 0

    if not row["ventana"]:
        if not quiet:
            print(t("no_esta_en_iterm", num=row["num"], name=row["name"],
                    tty=row["tty"] or t("proceso_muerto")), file=sys.stderr)
            print(t("cwd", cwd=row["cwd"]), file=sys.stderr)
        return 1
    app, wid, tab = row["ventana"]
    if app == "Terminal":
        # Terminal.app no tiene "sesiones" ni `select window`: la pestaña se elige por la
        # propiedad `selected tab` de la ventana, y la ventana se trae con `frontmost`.
        script = f'''
        tell application "Terminal"
          set selected tab of window id {wid} to tab {tab} of window id {wid}
          set frontmost of window id {wid} to true
          activate
        end tell
        '''
    else:
        script = f'''
        tell application "iTerm2"
          tell window id {wid} to select tab {tab}
          select window id {wid}
          activate
        end tell
        '''
    res = subprocess.run(["osascript", "-e", script], capture_output=True, text=True,
                         stdin=subprocess.DEVNULL)
    if res.returncode != 0:
        if not quiet:
            print(t("no_se_pudo_enfocar", error=res.stderr.strip()), file=sys.stderr)
        return 1
    if not quiet:
        print(f"→ {row['name']} ({row['repo']})")
    return 0


def abrir(row, exito):
    """
    Enter sobre una fila: enfocar si vive, reanudar si es recuperable.

    Es un solo punto a proposito. El panel llama a esto desde Enter y desde el doble clic,
    y si cada uno decidiera por su cuenta acabarian discrepando — ya paso con `try_focus`.
    """
    if row.get("recoverable"):
        return (t("recuperando", name=row["name"]) if resume(row, quiet=True) == 0
                else t("no_se_pudo_recuperar", name=row["name"]))
    return try_focus(row, exito)


def try_focus(row, exito):
    """
    Enfoca y devuelve el mensaje que toca. `exito` es el texto si sale bien.

    Al enfocar con exito se apunta en que escritorio quedo: la ventana esta delante, asi
    que el Space activo ES el suyo. Es la unica forma barata de saberlo, y se aprende
    usando la herramienta.

    Existe porque el par "enfocar + decidir el aviso" estaba copiado en cuatro sitios
    (enter, doble clic, ⌥N, y el ⌥N de la rama sin filas) y ya habia divergido: una de
    las copias se tragaba el fallo sin avisar.
    """
    if focus(row, quiet=True) != 0:
        return t("aviso_sin_iterm", name=row["name"])
    if row.get("sessionId") and not row.get("recoverable"):
        recordar_space(row["sessionId"])
    return exito


def jump_waiting(rows, n):
    """
    (sessionId, aviso) para saltar a la n-esima sesion esperando.

    Devuelve tambien el sessionId para que quien llama mueva el cursor: la copia que no
    lo hacia dejaba el cursor donde estuviera, con el panel enfocando otra ventana.
    """
    target, aviso = pick_waiting(rows, n)
    if aviso:
        return None, "⚠ " + aviso
    return target["sessionId"], try_focus(target, t("esperando_ordinal", n=n,
                                                    name=target["name"]))


# ─────────────────────────────── main ───────────────────────────────


def collect():
    """Una foto completa del estado. iTerm y `claude agents` van en paralelo (~0.4s menos)."""
    with ThreadPoolExecutor(max_workers=3) as pool:
        iterm_future = pool.submit(get_iterm_map)
        # Terminal.app va en su propio hilo aunque casi siempre devuelva vacio: el
        # `is running` corta en ~30 ms, pero cuando SI corre cuesta lo mismo que iTerm y
        # sumarlo en serie se notaria en cada refresco.
        term_future = pool.submit(get_terminal_map)
        sessions = get_sessions()
        if not sessions:
            iterm_future.cancel()
            term_future.cancel()
            return []
        numbers = assign_numbers(sessions)
        ttys = get_ttys([s["pid"] for s in sessions])
        # tmux cuesta ~11 ms y sale gratis si no esta instalado o no hay servidor: no
        # merece un hilo, pero si merece consultarse siempre. Quien no lo use no lo nota.
        tmux = get_tmux_map()
        # Un tty pertenece a una sola app, asi que los mapas no pueden chocar: cada uno
        # aporta las suyas.
        ventanas = dict(term_future.result())
        ventanas.update(iterm_future.result())
    return build(sessions, ttys, ventanas, numbers, tmux)


def procesos_claude():
    """
    Cuantos procesos `claude` hay vivos ahora mismo.

    Sirve para distinguir dos cosas que en pantalla se veian iguales: "no tienes ninguna
    sesion" y "las tienes, pero el registro no las ve". Lo segundo pasa **cuando Claude
    Code se actualiza solo**: los procesos que ya estaban siguen corriendo y desaparecen de
    `claude agents --json` hasta que los reinicies. Verificado el 2026-08-06 al pasar de
    2.1.220 a 2.1.224: tres sesiones vivas y el registro vacio; una sesion nueva, arrancada
    despues, aparecia al momento.
    """
    try:
        res = subprocess.run(["pgrep", "-x", "claude"], capture_output=True, text=True,
                             timeout=5, stdin=subprocess.DEVNULL)
    except (OSError, subprocess.SubprocessError):
        return 0
    return len(res.stdout.split())


# Cuantas recuperables se enseñan por defecto. 200 y no 20: con 20 la lista servia para
# "que se acaba de caer", pero no para BUSCAR — que es para lo que se usa. Con 111
# transcripts en disco, buscar entre los 20 mas recientes no encuentra casi nada.
#
# Y sale gratis: el coste lo domina el escaneo del directorio, no el numero de colas que se
# leen. Medido: 20 filas 0,41 s, 107 filas 0,44 s. El tope existe solo para acotar el caso
# raro de quien tenga miles; ahi `--recent 50` sigue estando.
RECENT_MAX = 200


def recent_rows(limite=RECENT_MAX):
    """
    Sesiones que YA NO CORREN pero se pueden reanudar, de la mas reciente hacia atras.

    Existe para el dia que iTerm se cae: entonces `claude agents --json` no devuelve nada
    —los procesos murieron con su terminal— y el panel se queda vacio justo cuando mas
    falta hace. Pero el estado sigue en disco, y `claude --resume <id>` lo recupera.

    **`claude` puede no estar disponible y aun asi hay que listar.** Es el escenario del
    desastre: si `get_sessions()` falla, se asume que no hay ninguna viva y se muestran
    todas. Al reves seria dejar sin la funcion a quien la necesita.

    El `mtime` solo sirve para PRESELECCIONAR candidatos baratos. El orden final va por el
    `timestamp` de dentro, porque el transcript se escribe en bloque y varias sesiones
    acaban con el mismo mtime exacto (ver CLAUDE.md).
    """
    try:
        vivas = {s["sessionId"] for s in get_sessions()}
    except SessionsUnavailable:
        vivas = set()

    candidatos = []
    for cfg in config_dirs():
        for ruta in glob.glob(os.path.join(cfg, "projects", "*", "*.jsonl")):
            sid = os.path.basename(ruta)[:-6]
            if sid in vivas:
                continue
            try:
                candidatos.append((os.path.getmtime(ruta), sid, cfg))
            except OSError:
                continue
    candidatos.sort(reverse=True)

    notas_sesion, notas_repo, pausadas, spaces = load_state()
    filas = []
    # Se leen mas de los que se van a enseñar porque el mtime miente un poco: asi el
    # recorte final por `ts` de verdad tiene de donde elegir.
    for _, sid, cfg in candidatos[:limite * 3]:
        info = read_transcript(sid, cfg)
        cwd = info.get("cwd")
        if not cwd:
            continue      # sin directorio no se puede reanudar: no sirve de nada enseñarla
        fila = {
            "num": 0,     # se numeran abajo, por orden de lo que se ve
            "name": sin_control(info.get("title") or sid[:8]),
            "account": sin_control(account_label(cfg) if len(config_dirs()) > 1 else ""),
            "repo": sin_control(os.path.basename(cwd)),
            "cwd": cwd,
            "kind": "interactive",
            "status": "idle",
            "sessionId": sid,
            "pid": 0,
            "tty": "",
            "ventana": None,
            "ts": info.get("ts"),
            "branch": sin_control(info.get("branch")),
            "model": short_model(info.get("model")),
            "effort": info.get("effort"),
            "title": sin_control(info.get("title")),
            "prompt": sin_control(info.get("prompt")),
            "note": "",
            "paused": sid in pausadas,
            "space": spaces.get(sid),
            "recoverable": True,
            "_cfg": cfg,
            "startedAt": 0,
        }
        fila["note"] = note_for(fila, notas_sesion, notas_repo)
        filas.append(fila)

    filas.sort(key=sort_key, reverse=True)
    filas = filas[:limite]
    for i, f in enumerate(filas, 1):
        f["num"] = i
    return filas


def resume(row, quiet=False):
    """
    Abre una pestaña nueva de iTerm en el directorio de la sesion y la reanuda.

    Dos capas de comillas y las dos importan:

    - **El comando del shell** se arma con `shlex.quote`, porque un directorio con un
      espacio o una comilla partiria el `cd`.
    - **El comando entero entra en el AppleScript por `argv`**, nunca interpolado, igual
      que en el resto: la ruta sale del transcript, o sea de fuera.

    Se escribe `claude` a secas y no la ruta resuelta: la pestaña nueva arranca un shell
    interactivo que ya carga nvm, y una ruta de nvm fijada aqui caduca al actualizar Node.
    """
    orden = "cd {} && claude --resume {}".format(
        shlex.quote(row["cwd"]), shlex.quote(row["sessionId"]))
    if pestaña_nueva(orden, quiet, row.get("space")) != 0:
        return 1
    if not quiet:
        print(t("recuperada", name=row["name"], repo=row["repo"]))
    return 0


def pestaña_nueva(orden, quiet=False, space=None):
    """
    Abre una pestaña de iTerm y ejecuta `orden`. La usan `resume()` y el attach de tmux.

    **`orden` entra por `argv`, nunca interpolada.** Lleva rutas que salen del transcript y
    nombres de sesion de tmux: texto de fuera dentro de un script que se ejecuta.

    Con `space`, primero se cambia a ese escritorio y luego se crea una **ventana** en vez
    de una pestaña. Las dos cosas son necesarias: una pestaña se añade a la ventana actual,
    que puede estar en otro escritorio, y entonces no habriamos vuelto a ninguna parte.
    """
    en_su_space = space is not None and ir_a_space(space)
    # Se escribe en la ventana/pestaña **que se acaba de crear**, capturandola en una
    # variable — nunca en "current session of current window".
    #
    # EL FALLO: tras el `gotoSpace`, la ventana nueva todavia no es la "current" para
    # iTerm2; la clave sigue siendo la que tenias delante, que es **la que corre `ccl`**.
    # Asi que el `write text` te tecleaba el `cd … && claude --resume …` DENTRO del panel,
    # donde aparecia como filtro. Apuntando al objeto creado no depende de a quien
    # considere iTerm la ventana activa en ese instante.
    script = '''
    on run argv
      tell application "iTerm2"
        activate
        if (count of windows) = 0 or (item 2 of argv) is "ventana" then
          set destino to (create window with default profile)
        else
          tell current window
            set destino to (create tab with default profile)
          end tell
        end if
        tell current session of destino to write text (item 1 of argv)
      end tell
    end run
    '''
    try:
        res = subprocess.run(
            ["osascript", "-e", script, "--", orden,
             "ventana" if en_su_space else "pestaña"],
            capture_output=True, text=True, timeout=20, stdin=subprocess.DEVNULL)
    except (OSError, subprocess.SubprocessError) as e:
        if not quiet:
            print(t("no_se_pudo_enfocar", error=e), file=sys.stderr)
        return 1
    if res.returncode != 0:
        if not quiet:
            print(t("no_se_pudo_enfocar", error=res.stderr.strip()), file=sys.stderr)
        return 1
    return 0


class FeedFijo:
    """
    Un `Feed` que no refresca nunca, para `--recent`.

    Las filas de ahi salen de disco, no de `claude agents`: un refresco normal las
    sustituiria por las sesiones vivas y la lista de recuperables desapareceria sola a los
    cuatro segundos. Misma interfaz que `Feed` para que `interactive()` no note la
    diferencia.
    """

    def __init__(self, rows):
        self.rows = rows

    def snapshot(self):
        return self.rows, 0

    def touch(self):
        pass

    def force(self):
        pass

    def stop(self):
        pass


def parse_args(argv):
    """
    (opciones, error) — parseo a mano, sin argparse: son cuatro banderas y argparse
    tarda mas en importarse que todo lo demas en arrancar.
    """
    opts = {"list": False, "num": None, "waiting": None, "help": False,
            "version": False, "table": False, "recent": None}
    i = 0
    while i < len(argv):
        a = argv[i]
        if a in ("-V", "--version"):
            opts["version"] = True
        elif a in ("-h", "--help"):
            opts["help"] = True
        elif a in ("-l", "--list"):
            opts["list"] = True
        elif a in ("-t", "--table"):
            opts["table"] = True
        elif a == "--recent":
            nxt = argv[i + 1] if i + 1 < len(argv) else None
            if nxt is not None and nxt.isdigit():
                opts["recent"] = int(nxt)
                i += 1
            else:
                opts["recent"] = RECENT_MAX
        elif a in ("-w", "--waiting"):
            # el numero puede ir suelto ("-w 2") o pegado ("-w2"); sin numero, la primera
            nxt = argv[i + 1] if i + 1 < len(argv) else None
            if nxt is not None and nxt.isdigit():
                opts["waiting"] = int(nxt)
                i += 1
            else:
                opts["waiting"] = 1
        elif a.startswith("-w") and a[2:].isdigit():
            opts["waiting"] = int(a[2:])
        elif a.isdigit():
            opts["num"] = int(a)
        else:
            return opts, t("opcion_desconocida", opcion=a)
        i += 1
    if opts["waiting"] is not None and opts["waiting"] < 1:
        return opts, t("w_desde_uno")
    if opts["recent"] is not None and opts["recent"] < 1:
        return opts, t("recent_desde_uno")
    return opts, None


def main():
    opts, err = parse_args(sys.argv[1:])
    if err:
        print(f"ccl: {err}\n", file=sys.stderr)
        # solo la cabecera con el uso, no la pagina entera: quien se equivoca en un
        # argumento necesita la sintaxis, no las limitaciones conocidas
        print(uso().split("\n\n`-w`")[0], file=sys.stderr)
        return 2
    if opts["version"]:
        print(f"ccl {__version__}")
        return 0
    if opts["help"]:
        print(uso())
        return 0

    try:
        rows = collect()
    except SessionsUnavailable as e:
        print(f"ccl: {e}", file=sys.stderr)
        return 1

    if opts["recent"] is not None:
        # Tambien antes del "no hay sesiones", y por el mismo motivo elevado al cuadrado:
        # el caso de uso ES que no haya ninguna viva porque se cayo el terminal.
        recuperables = recent_rows(opts["recent"])
        if not recuperables:
            print(t("sin_recuperables"))
            return 0
        if opts["list"] or not sys.stdin.isatty() or not sys.stdout.isatty():
            render(recuperables, opts["table"])
            return 0
        interactive(FeedFijo(recuperables), opts["table"])
        return 0

    if not rows:
        vivos = procesos_claude()
        print(t("sin_sesiones_pero_vivas", n=vivos) if vivos else t("sin_sesiones"))
        return 0

    if opts["waiting"] is not None:
        row, aviso = pick_waiting(rows, opts["waiting"])
        if not row:
            print(f"ccl: {aviso}.", file=sys.stderr)
            return 1
        return focus(row)

    if opts["num"] is not None:
        row = next((r for r in rows if r["num"] == opts["num"]), None)
        if not row:
            print(t("no_existe_numero", n=opts["num"]), file=sys.stderr)
            return 1
        return focus(row)

    # Sin TTY (pipe, script) o --list: salida estatica, sin interaccion
    if opts["list"] or not sys.stdin.isatty() or not sys.stdout.isatty():
        render(rows, opts["table"])
        return 0

    feed = Feed(rows)
    try:
        interactive(feed, opts["table"])
    finally:
        feed.stop()
    return 0


if __name__ == "__main__":
    sys.exit(main())
