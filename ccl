def detect_lang():
    """
    'en' o 'es'. `CCL_LANG` manda; si no, el locale; si no hay nada, ingles.

    Se mira `LC_ALL` y `LC_MESSAGES` antes de `LANG` porque es el orden de precedencia de
    POSIX: quien exporta `LC_ALL=C` para scripts espera que gane sobre `LANG`.
    """
    for var in ("CCL_LANG", "LC_ALL", "LC_MESSAGES", "LANG"):
        valor = os.environ.get(var)
        if valor:
            return "es" if valor.lower().startswith("es") else "en"
    return "en"


