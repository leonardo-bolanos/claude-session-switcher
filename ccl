_TTY = sys.stdout.isatty()


def c(code, text):
    return f"\033[{code}m{text}\033[0m" if _TTY else text


DIM = lambda s: c("2", s)
BOLD = lambda s: c("1", s)
GREEN = lambda s: c("32", s)
YELLOW = lambda s: c("33", s)
CYAN = lambda s: c("36", s)
BLUE = lambda s: c("34", s)
MAGENTA = lambda s: c("35", s)
RED = lambda s: c("31", s)
GREY = lambda s: c("90", s)
# La nota es lo unico de la linea de detalle que escribio el usuario, y esa linea es casi
# toda DIM y grises: sin resaltarla se perdia entre la rama y el modelo.
#
# Salmon apagado, y es el unico sitio del script que se sale de los 16 colores ANSI. Con
# 16 no se podia: los libres estaban cogidos —magenta es el repo, verde/azul/gris los
# modelos, amarillo el effort, gris la rama— y de rojo solo hay `31`, que aqui significa
# error y ⚠. Una nota no es una alarma, asi que hace falta un rojo desaturado, y eso ya
# solo existe en la paleta de 256.
#
# Requiere un terminal con 256 colores (iTerm2 los tiene). Uno que no los soporte ignora
# el codigo y pinta el texto en su color normal: se pierde el enfasis, no se rompe nada.
#
# Negrita y color en un solo codigo, no BOLD(...): anidado deja dos resets pegados.
NOTE = lambda s: c("1;38;5;174", s)

ANSI_RE = re.compile(r"\033\[[0-9;]*m")
TTY_RE = re.compile(r"(?:/dev/)?tty[a-z]*\d+")


def char_width(ch):
    """
    Columnas que ocupa un caracter en la terminal.

    No es lo mismo que len(): los ideogramas CJK y muchos emoji ocupan DOS columnas,
    y los diacriticos combinantes cero. Contarlos como uno desalinea las columnas.
    """
    if unicodedata.combining(ch):
        return 0
    return 2 if unicodedata.east_asian_width(ch) in ("W", "F") else 1


def vis(s):
    """Ancho visible en columnas: ignora los codigos de color y cuenta los CJK como 2."""
    return sum(char_width(c) for c in ANSI_RE.sub("", s))


def pad(s, width):
    """ljust consciente de los codigos de color."""
    return s + " " * max(0, width - vis(s))


def clip(s, width):
    """Recorta a un ancho visible, sin partir una secuencia de escape."""
    if vis(s) <= width:
        return s
    out, seen = [], 0
    i = 0
    while i < len(s):
        m = ANSI_RE.match(s, i)
        if m:
            out.append(m.group()); i = m.end(); continue
        w = char_width(s[i])
        if seen + w > width:   # no partir un caracter de doble ancho por la mitad
            break
        out.append(s[i]); seen += w; i += 1
    res = "".join(out)
    # cerrar el color solo si de verdad habia alguno abierto: si no, el reset
    # se veria como texto literal "[0m" en salidas sin color (pipes, --list)
    return res + "\033[0m" if ANSI_RE.search(res) else res


def color_model(m):
    """Cada familia con su color, para reconocerla de un vistazo."""
    if not m:
        return ""
    if m.startswith("opus"):
        return BLUE(m)
    if m.startswith("sonnet"):
        return GREEN(m)
    if m.startswith("haiku"):
        return GREY(m)
    if m.startswith("fable"):
        return MAGENTA(m)
    return m


def color_effort(e):
    """Resalta solo lo caro: xhigh/max saltan a la vista."""
    if not e:
        return ""
    return YELLOW(e) if e in ("xhigh", "max") else DIM(e)


def color_age(ts):
    """Verde lo reciente, gris lo viejo."""
    # Se decide con los MINUTOS, no mirando el texto. Antes comparaba contra "hace ..." y
    # con la interfaz en dos idiomas eso dejaba de funcionar en silencio: en ingles no
    # empieza por "hace", asi que todo salia en gris.
    # `ago(ts)` una sola vez: se llama por fila y por repintado, y cada llamada vuelve a
    # parsear la marca. Antes se parseaba tres veces (una en minutes_since, dos dentro de
    # ago) para pintar una columna.
    texto, mins = ago(ts), minutes_since(ts)
    if mins is None or mins < 60:
        return GREEN(texto)         # sin dato ("?") no es viejo
    if mins < 24 * 60:
        return YELLOW(texto)
    return DIM(texto)


# ─────────────────────────── recoleccion de datos ───────────────────────────


class SessionsUnavailable(Exception):
    """No se pudo consultar a `claude`. Distinto de 'hay cero sesiones'."""


def config_dirs():
    """
    Directorios de configuracion de Claude Code a consultar.

    Por defecto ~/.claude mas cualquier hermano ~/.claude-<algo> que tenga projects/
    dentro (asi se ven las sesiones de una segunda cuenta sin configurar nada).
    Se puede fijar la lista con CCL_CONFIG_DIRS, separada por ':'.
    """
    override = os.environ.get("CCL_CONFIG_DIRS")
    if override:
        dirs = [os.path.expanduser(p) for p in override.split(":") if p.strip()]
        return [d for d in dirs if os.path.isdir(d)]

    found = [os.path.join(HOME, ".claude")]
    for name in sorted(os.listdir(HOME)):
        if not name.startswith(".claude-"):
            continue
        path = os.path.join(HOME, name)
        if os.path.isdir(os.path.join(path, "projects")):
            found.append(path)
    return [d for d in found if os.path.isdir(d)]


def account_label(cfg_dir):
    """'' para el principal, '-personal' para ~/.claude-personal, etc."""
    base = os.path.basename(cfg_dir)
    return "" if base == ".claude" else base.replace(".claude-", "", 1)


# Donde buscar `claude` si no esta en el PATH, en orden. El glob de nvm cubre npm bajo
# nvm, que es lo mas comun y lo peor: la ruta lleva la version de Node y cambia al
# actualizarla, asi que no se puede fijar a mano en la config de nadie.
CLAUDE_EXTRA = [
    "~/.claude/local/claude",              # instalador oficial
    "~/.local/bin/claude",
    "/opt/homebrew/bin/claude",
    "/usr/local/bin/claude",
    "~/.nvm/versions/node/*/bin/claude",   # npm bajo nvm
    "~/.volta/bin/claude",
    "~/.bun/bin/claude",
]

_claude_bin = None   # cache: el glob no se repite en cada refresco (cada 4s)


def claude_bin():
    """
    Ruta del ejecutable `claude`, buscando fuera del PATH si hace falta.

    Un lanzador (Hammerspoon, Raycast, launchd, cron) arranca el proceso con el PATH
    minimo de launchd — `/usr/bin:/bin:/usr/sbin:/sbin` — donde `claude` NO esta. Sin
    esta busqueda, `ccl -w` fallaba desde un atajo global y funcionaba desde la terminal,
    que es el peor sintoma posible: parece cosa del atajo y no lo es.
    """
    global _claude_bin
    if _claude_bin:
        return _claude_bin
    hallado = shutil.which("claude")
    if not hallado:
        cands = []
        for patron in CLAUDE_EXTRA:
            cands.extend(glob.glob(os.path.expanduser(patron)))
        cands = [c for c in cands if os.access(c, os.X_OK)]
        # el mas reciente por fecha, NO por nombre: con varias versiones de Node hay un
        # `claude` por cada una, y ordenar los nombres pone v25.9.0 delante de v25.10.0
        if cands:
            hallado = max(cands, key=lambda p: os.stat(p).st_mtime)
    _claude_bin = hallado
    return hallado


def _sessions_from(cfg_dir):
    env = dict(os.environ, CLAUDE_CONFIG_DIR=cfg_dir)
    try:
        proc = subprocess.run(
            [claude_bin() or "claude", "agents", "--cwd", HOME, "--json"],
            capture_output=True, text=True, timeout=30, env=env,
        )
    except FileNotFoundError:
        raise SessionsUnavailable(t("sin_comando"))
    except subprocess.TimeoutExpired:
        raise SessionsUnavailable(t("timeout"))
    except Exception as e:
        raise SessionsUnavailable(t("no_pude_ejecutar", error=e))

    try:
        out = json.loads(proc.stdout)
    except ValueError:
        detail = (proc.stderr or proc.stdout or "").strip().splitlines()
        pista = t("dijo", detalle=detail[0][:120]) if detail else ""
        raise SessionsUnavailable(t("no_es_json", pista=pista))
    for s in out:
        s["_cfg"] = cfg_dir
        s["_account"] = account_label(cfg_dir)
    return out


def get_sessions():
    """
    Sesiones de TODAS las cuentas detectadas, cada una etiquetada con la suya.

    Lanza SessionsUnavailable solo si falla la primera cuenta (el caso de "claude no
    esta instalado"). Si una cuenta secundaria falla, se ignora: no tiene sentido
    dejar sin panel al usuario porque una config extra este rota.
    """
    # Orden del diagnostico, de la causa mas profunda a la mas superficial: si falta
    # el comando, decirlo primero. Al reves, alguien sin Claude Code instalado leia
    # "no hay directorio de config", que manda a buscar el problema equivocado.
    if claude_bin() is None:
        raise SessionsUnavailable(t("sin_comando"))

    dirs = config_dirs()
    if not dirs:
        raise SessionsUnavailable(t("sin_config", home=HOME))

    todas, primero = [], True
    for d in dirs:
        try:
            todas.extend(_sessions_from(d))
        except SessionsUnavailable:
            if primero:
                raise
        primero = False
    return todas


def get_ttys(pids):
    """Un solo `ps` para todos los PIDs -> {pid: tty}."""
    if not pids:
        return {}
    try:
        out = subprocess.run(
            ["ps", "-o", "pid=,tty=", "-p", ",".join(str(p) for p in pids)],
            capture_output=True, text=True, timeout=10,
        ).stdout
    except Exception:
        return {}
    result = {}
    for line in out.strip().splitlines():
        parts = line.split()
        if len(parts) >= 2:
            result[int(parts[0])] = parts[1]
    return result


def get_iterm_map():
    """
    {tty: (window_id, tab_index)}. Vacio si iTerm no corre.

    Usa dos gets masivos en vez de recorrer sesion por sesion: resolver la ruta
    completa (`tty of session s of tab t of window w`) cuesta una llamada IPC por
    propiedad y tardaba 2.2s con 44 pestañas. Asi baja a ~0.5s.

    La lista plana de ttys viene en orden ventana > pestaña > sesion, y los conteos
    por ventana permiten reconstruir a que pestaña pertenece cada una. Verificado
    contra la version lenta: 44/44 identicas.
    """
    script = '''
    tell application "iTerm2"
      set AppleScript's text item delimiters to ","
      set r to ""
      repeat with w in windows
        set r to r & ((id of w) as text) & ":" & ((count of tabs of w) as text) & ","
      end repeat
      set tl to (tty of sessions of tabs of windows) as text
      set AppleScript's text item delimiters to ""
      return r & "@@@" & tl
    end tell
    '''
    try:
        out = subprocess.run(
            ["osascript", "-e", script], capture_output=True, text=True, timeout=15
        ).stdout.strip()
    except Exception:
        return {}
    if "@@@" not in out:
        return {}

    head, ttys = out.split("@@@", 1)
    wins = [p.split(":") for p in head.strip().rstrip(",").split(",") if ":" in p]
    # Validar la forma: si los text item delimiters fallaran, los ttys llegarian
    # concatenados ("/dev/ttys001/dev/ttys002") y produciriamos claves basura que
    # no casan con nada. Mejor descartarlas y que se vea el aviso "sin iTerm".
    tlist = [t for t in (x.strip() for x in ttys.split(",")) if TTY_RE.fullmatch(t)]

    result = {}
    i = 0
    for wid, count in wins:
        try:
            n = int(count)
        except ValueError:
            continue
        for tab in range(1, n + 1):
            if i >= len(tlist):
                break
            result[tlist[i].replace("/dev/", "")] = (wid.strip(), tab)
            i += 1
    return result


def read_transcript(session_id, cfg_dir=None):
    """
    Lee solo la cola del transcript. Todo campo es opcional.

    `cfg_dir` es el directorio de config de la cuenta duena de la sesion; sin el se
    buscaria siempre en ~/.claude y las sesiones de una segunda cuenta saldrian sin
    rama, modelo ni ultimo prompt.
    """
    info = {}
    base = cfg_dir or os.path.join(HOME, ".claude")
    hits = glob.glob(os.path.join(base, "projects", "*", f"{session_id}.jsonl"))
    if not hits:
        return info
    try:
        with open(hits[0], "rb") as fh:
            fh.seek(0, os.SEEK_END)
            size = fh.tell()
            fh.seek(max(0, size - TAIL_BYTES))
            chunk = fh.read().decode("utf-8", "ignore")
    except Exception:
        return info

    for line in chunk.split("\n"):
        line = line.strip()
        if not line:
            continue
        try:
            o = json.loads(line)
        except Exception:
            continue  # linea truncada por el corte de la cola
        if not isinstance(o, dict):
            continue
        for key, field in (("timestamp", "ts"), ("gitBranch", "branch"), ("effort", "effort")):
            if o.get(key):
                info[field] = o[key]
        if o.get("type") == "ai-title" and o.get("aiTitle"):
            info["title"] = o["aiTitle"]
        if o.get("type") == "last-prompt" and o.get("lastPrompt"):
            info["prompt"] = o["lastPrompt"]
        msg = o.get("message")
        if isinstance(msg, dict) and msg.get("model"):
            info["model"] = msg["model"]
    return info


def leer_json(ruta, defecto):
    """
    El JSON de `ruta`, o `defecto` si falta, esta corrupto o no se puede leer.

    Los dos indices que guarda `ccl` (numeros y notas) son cache o comodidad, nunca datos
    que no se puedan regenerar: **un archivo roto no puede impedir que el panel arranque**.
    """
    try:
        with open(ruta) as fh:
            datos = json.load(fh)
    except Exception:
        return defecto
    return datos if isinstance(datos, type(defecto)) else defecto


def escribir_json(ruta, datos):
    """
    Escribe `datos` en `ruta`, creando el directorio. Si falla, se traga el error.

    Sin persistencia se sigue funcionando: se pierde al salir, pero nada mas. Es el mismo
    criterio en los dos indices, y por eso vive en un solo sitio.
    """
    try:
        os.makedirs(os.path.dirname(ruta), exist_ok=True)
        with open(ruta, "w") as fh:
            json.dump(datos, fh, indent=2, ensure_ascii=False, sort_keys=True)
        # 0600: las notas son texto personal —nombres de gente, en que estas esperando— y
        # con el umask habitual (022) el fichero salia legible para el grupo. En una maquina
        # de un solo usuario no hay exposicion real, pero es gratis no dejarlo abierto.
        os.chmod(ruta, 0o600)
    except Exception:
        pass


# ─────────────────────────── numeracion estable ───────────────────────────


def assign_numbers(sessions):
    """sessionId -> numero fijo. Recicla los numeros de sesiones muertas."""
    index = leer_json(INDEX_FILE, {})

    live = {s["sessionId"] for s in sessions}
    index = {sid: n for sid, n in index.items() if sid in live}  # purgar muertas
    used = set(index.values())

    for s in sessions:
        sid = s["sessionId"]
        if sid not in index:
            n = 1
            while n in used:
                n += 1
            index[sid] = n
            used.add(n)

    escribir_json(INDEX_FILE, index)
    return index


# ─────────────────────────── notas personales ───────────────────────────


def load_notes():
    """
    ({sessionId: nota}, {cwd: nota}) — tus notas, por sesion y por repo.

    Van por **sesion**, y la del repo es el respaldo: si una sesion no tiene nota propia,
    se ve la de su directorio. Las dos cosas hacen falta porque son dos usos distintos:

      - "esperando que Felipe haga algo" es el estado de UNA conversacion. Atarlo al repo
        lo pintaba en las otras tres sesiones del mismo directorio, que es el fallo que
        hizo cambiar esto: con 16 sesiones en 11 directorios, el 43% no podia tener nota
        propia.
      - "backend de facturacion" describe el repo y vale para todas sus sesiones, y encima
        sobrevive a reiniciar Claude Code (que cambia el sessionId).

    En disco: {"por_sesion": {...}, "por_repo": {...}}. Se acepta tambien el formato viejo
    —un dict plano {cwd: nota}— y se lee como `por_repo`: quien ya tenia notas escritas no
    puede perderlas por un cambio de formato.
    """
    datos = leer_json(NOTES_FILE, {})
    if "por_sesion" in datos or "por_repo" in datos:
        crudo_sesion, crudo_repo = datos.get("por_sesion"), datos.get("por_repo")
    else:
        crudo_sesion, crudo_repo = {}, datos     # formato viejo: todo era por directorio

    def limpio(d):
        # los valores tambien se filtran: una nota tiene que ser texto. Un JSON valido con
        # la forma equivocada (una lista, un numero) no puede llegar a la linea de detalle.
        if not isinstance(d, dict):
            return {}
        return {k: v for k, v in d.items() if isinstance(k, str) and isinstance(v, str)}

    return limpio(crudo_sesion), limpio(crudo_repo)


def note_for(row, notas_sesion, notas_repo):
    """La nota que le toca a una fila: la suya si tiene, y si no la de su repo."""
    return notas_sesion.get(row["sessionId"]) or notas_repo.get(row["cwd"], "")


def save_note(session_id, nota):
    """
    Guarda la nota de una sesion, o la borra si queda vacia. Devuelve la nota final.

    Borrarla hace reaparecer la del repo, si hay: es la forma de "quitar lo mio y volver a
    lo de siempre" sin tener que editar el JSON.

    No purga nada: ni las sesiones muertas ni los directorios que ya no existen. Un disco
    externo desmontado o un repo movido de sitio borraria algo escrito a mano, y el archivo
    son unos pocos KB aunque acumule.
    """
    sesion, repo = load_notes()
    nota = " ".join(sin_control(str(nota)).split())[:NOTE_MAX]   # una linea, sin control
    if nota:
        sesion[session_id] = nota
    else:
        sesion.pop(session_id, None)
    escribir_json(NOTES_FILE, {"por_sesion": sesion, "por_repo": repo})
    return nota


# ─────────────────────────────── formato ───────────────────────────────


# Todo lo que se pinta y viene de FUERA pasa por aqui: el nombre de la sesion, el repo, la
# rama, el ultimo prompt, el titulo. El caso que importa es el prompt, que sale del
# transcript de Claude Code — o sea de lo que se teclea Y SE PEGA ahi.
#
# Un `\033[2A` colado en un prompt mueve el cursor dos lineas arriba y el texto siguiente
# reescribe la fila de OTRA sesion: en una herramienta cuyo trabajo es "llevame a la sesion
# correcta", falsear una fila es el peor fallo posible. `\n`, `\r` y `\t` ya se quitaban al
# normalizar espacios, pero las secuencias que empiezan por ESC y el BEL llegaban intactas.
#
# Ademas ANSI_RE solo reconoce SGR (`\033[...m`), asi que una secuencia OSC no se contaba en
# el ancho visible y descuadraba las columnas: 51 columnas calculadas para 101 bytes.
# El ORDEN de las alternativas importa: la del OSC va primera porque hay que comerse su
# carga entera. Si va despues, la generica de dos bytes casa solo `ESC ]` y el payload
# ("1337;SetUserVar=…") se queda como texto visible en la fila.
CONTROL_RE = re.compile(
    r"\033\][^\a\033]*(?:\a|\033\\)?"    # OSC … BEL / ST, con su carga
    r"|\033\[[0-?]*[ -/]*[@-~]"          # CSI (colores, mover el cursor, borrar…)
    r"|\033[@-Z\\-_]"                    # cualquier otra secuencia de dos bytes
    r"|[\x00-\x08\x0b-\x1f\x7f]"         # y los controles sueltos (BEL, NUL, DEL…)
)


def sin_control(texto):
    """Quita caracteres de control y secuencias de escape de un texto que viene de fuera."""
    return CONTROL_RE.sub("", texto) if isinstance(texto, str) else texto


def parse_ts(iso_ts):
    """La marca como datetime local, o None si falta o no se entiende."""
    if not iso_ts:
        return None
    try:
        return datetime.datetime.fromisoformat(iso_ts.replace("Z", "+00:00")).astimezone()
    except Exception:
        return None


def minutes_since(iso_ts):
    """
    Minutos transcurridos, o None si no hay marca.

    Existe aparte de `ago()` porque `color_age` necesita el NUMERO. Antes decidia el
    color mirando el texto ("empieza por 'hace '"), y con la interfaz en dos idiomas eso
    dejaba de funcionar en silencio: en ingles no empieza por "hace", asi que todo salia
    en gris sin que nada fallara.
    """
    dt = parse_ts(iso_ts)
    if dt is None:
        return None
    return (datetime.datetime.now(dt.tzinfo) - dt).total_seconds() / 60


def ago(iso_ts):
    """
    'now' / '5m ago' / '3h ago' / 'yesterday 17:31' / '24-jul 21:52' (o su equivalente
    en español, segun el idioma activo).

    Se basa en el tiempo TRANSCURRIDO, no en el dia del calendario. Antes usaba
    `now.date() == dt.date()` para decidir si mostrar horas, y eso hacia que lo mismo
    se viera distinto segun la hora: a las 15:00, algo de hace 3h salia como "hace 3h";
    a las 02:00 cruzaba medianoche y salia como "ayer 23:00". Lo cazo el CI, que corre
    en UTC de madrugada.
    """
    dt = parse_ts(iso_ts)
    if dt is None:
        return "?"
    # con el dt ya resuelto, no se vuelve a parsear la cadena
    mins = (datetime.datetime.now(dt.tzinfo) - dt).total_seconds() / 60
    if mins < 0:
        return t("ahora")       # reloj desincronizado: no mostrar futuro
    if mins < 1:
        return t("ahora")
    if mins < 60:
        return t("hace_min", n=int(mins))
    if mins < 24 * 60:
        return t("hace_hora", n=int(mins / 60))
    if mins < 48 * 60:
        return t("ayer", hora=dt.strftime("%H:%M"))
    return dt.strftime("%d-%b %H:%M").lower()


def short_model(m):
    if not m:
        return None
    return m.replace("claude-", "").replace("-20", " ").split()[0]


def build(sessions, ttys, iterm, numbers):
    rows = []
    notas_sesion, notas_repo = load_notes()   # una lectura por refresco: es diminuto
    for s in sessions:
        info = read_transcript(s["sessionId"], s.get("_cfg"))
        tty = ttys.get(s["pid"], "")
        rows.append({
            "num": numbers[s["sessionId"]],
            "name": sin_control(s["name"]),
            "account": sin_control(s.get("_account", "")),
            "repo": sin_control(os.path.basename(s["cwd"])),
            "cwd": s["cwd"],
            "kind": s.get("kind", "interactive"),
            "status": s.get("status", "idle"),
            "sessionId": s["sessionId"],
            "pid": s["pid"],
            "tty": tty,
            "iterm": iterm.get(tty),
            "ts": info.get("ts"),
            "branch": sin_control(info.get("branch")),
            "model": short_model(info.get("model")),
            "effort": info.get("effort"),
            "title": sin_control(info.get("title")),
            "prompt": sin_control(info.get("prompt")),
            "note": "",   # se rellena abajo, cuando la fila ya existe
            "startedAt": s.get("startedAt", 0),
        })
        rows[-1]["note"] = note_for(rows[-1], notas_sesion, notas_repo)
    return rows


def sort_key(r):
    """Mas reciente primero. Sin timestamp -> al final, desempata por inicio."""
    return (r["ts"] or "", r["startedAt"])


def matches(row, query):
    """
    Coincidencia laxa: sin acentos, sin mayusculas, sobre nombre, repo, rama, cuenta y
    **tu nota** — que es media razon para escribirla: poner "facturacion" a un repo que
    se llama `web-app` y poder encontrarlo por esa palabra.
    """
    if not query:
        return True
    heno = strip_accents(" ".join(str(row.get(k) or "")
                                  for k in ("name", "repo", "branch", "account",
                                            "note")).lower())
    return all(t in heno for t in strip_accents(query.lower()).split())


def strip_accents(s):
    return "".join(ch for ch in unicodedata.normalize("NFD", s)
                   if not unicodedata.combining(ch))


def multi_account(rows):
    """True si hay sesiones de mas de una cuenta: solo entonces vale la pena la columna."""
    return len({r.get("account", "") for r in rows}) > 1


def is_waiting(row):
    """
    True si la sesion esta esperando algo tuyo: interactiva y no ocupada.

    OJO con el nombre: `claude agents --json` solo distingue busy/idle, no existe un
    "esperando tu respuesta" real (ver CLAUDE.md). Esto es lo mas cerca que se puede
    estar. Compartido con `grouped` a proposito, para que "la primera esperando" sea
    literalmente la primera que se ve en el panel y no dos criterios que se separan.
    """
    return row["status"] != "busy" and row["kind"] != "background"


def waiting_rows(rows):
    """
    Las sesiones esperando, ya ordenadas. **Es la unica fuente de verdad**: `grouped` la
    usa para su grupo, asi que el panel y `-w`/`⌥N` no pueden discrepar ni al filtrar ni
    al ordenar. Antes eran dos implementaciones paralelas que habia que sincronizar a
    mano, con un test dedicado a cazar la deriva.
    """
    return sorted((r for r in rows if is_waiting(r)), key=sort_key, reverse=True)


def pick_waiting(rows, n):
    """
    (fila, aviso) — la n-esima sesion esperando, 1-indexada.

    Puro a proposito: el salto lo hace quien llama. Asi se puede probar la eleccion
    sin enfocar ninguna ventana, que le robaria el foco a quien use la maquina.
    """
    pend = waiting_rows(rows)
    if not pend:
        return None, t("ninguna_esperando")
    if n < 1 or n > len(pend):
        return None, t("solo_hay_esperando", n=len(pend))
    return pend[n - 1], None


def grouped(rows):
    """[(etiqueta, color, filas-ordenadas)] — grupos vacios se omiten."""
    out = [
        (t("grupo_busy"), GREEN, [r for r in rows if r["status"] == "busy"]),
        (t("grupo_idle"), YELLOW, waiting_rows(rows)),
    ]
    # Grupos de background: solo si existen de verdad
    bg = [r for r in rows if r["kind"] == "background" and r["status"] != "busy"]
    if bg:
        out.append((t("grupo_bg"), CYAN, bg))
    return [(lbl, col, sorted(items, key=sort_key, reverse=True))
            for lbl, col, items in out if items]


def main_line(r, show_account=False):
    """Linea principal coloreada, con las columnas alineadas por ancho VISIBLE."""
    num = CYAN(BOLD(f"[{r['num']:>2}]"))
    name = pad(BOLD(r["name"][:36]), 38)
    repo = pad(MAGENTA(r["repo"][:15]), 17)
    # La cuenta solo se muestra si hay mas de una configurada: en el caso normal
    # seria una columna vacia en todas las filas.
    acct = pad(GREY(r.get("account") or ""), 11) if show_account else ""
    warn = RED(" ⚠") if not r["iterm"] else ""
    return f"{num} {name}{repo}{acct}{color_age(r['ts'])}{warn}"


def detail_line(r, width=None):
    """Tu nota · rama · modelo · effort · ultimo prompt. Cada pieza con su color."""
    # La nota va PRIMERA y en su propio color: es lo unico de la linea que escribiste tu,
    # y puesta al final la habria comido el recorte cuando el prompt es largo.
    nota = NOTE("✎ " + r["note"]) if r.get("note") else ""
    meta = [x for x in (nota,
                        GREY(r["branch"]) if r["branch"] else "",
                        color_model(r["model"]),
                        color_effort(r["effort"])) if x]
    out = DIM(" · ").join(meta)
    note = r["prompt"] or r["title"]
    if note:
        note = " ".join(str(note).split())
        quoted = DIM('"') + note + DIM('"')
        out = f"{out}{DIM(' · ')}{quoted}" if out else quoted
    return clip(out, width) if width else out


def render(rows):
    """Listado estatico de dos lineas por sesion (para --list y terminales sin TTY)."""
    width = (os.get_terminal_size().columns if sys.stdout.isatty() else 110)
    multi = multi_account(rows)
    print()
    for label, color, items in grouped(rows):
        print(color(BOLD(f"  {label} ({len(items)})")))
        print()
        for r in items:
            print("  " + main_line(r, multi))
            d = detail_line(r, width - 9)
            if d:
                print("       " + d)
        print()


# ───────────────────────── selector interactivo ─────────────────────────


MOUSE_ON = "\033[?1000h\033[?1006h"   # solo clics: 1002/1003 (arrastre, movimiento) no
MOUSE_OFF = "\033[?1006l\033[?1000l"
DOUBLE_CLICK = 0.4                    # segundos entre dos clics para que cuenten como doble


def _mouse_event(boton, fila):
    """Traduce un boton del protocolo a una tecla nuestra. None = no nos interesa."""
    if boton == 64:
        return "wheelup"
    if boton == 65:
        return "wheeldn"
    if boton == 0:
        return f"click:{fila}"
    return "mouse-otro"


def _read_mouse_sgr(fd):
    """
    Modo SGR (1006): ESC [ < boton ; columna ; fila (M|m).

    Solo el press ('M') vale; el release ('m') se descarta, o cada clic contaria dos
    veces y un clic simple pareceria doble.
    """
    buf = ""
    while len(buf) < 20:
        if not select.select([fd], [], [], 0.05)[0]:
            return "esc"
        ch = os.read(fd, 1).decode("utf-8", "ignore")
        if ch in ("M", "m"):
            if ch == "m":
                return "mouse-release"
            partes = buf.split(";")
            if len(partes) != 3 or not all(p.isdigit() for p in partes):
                return "esc"
            boton, _col, fila = (int(p) for p in partes)
            return _mouse_event(boton, fila)
        buf += ch
    return "esc"


def _read_mouse_x10(fd):
    """
    Modo antiguo (1000 sin SGR): ESC [ M seguido de tres bytes, cada uno +32.

    Se maneja aunque pidamos SGR porque un terminal que ignore 1006 mandaria esto, y
    sin decodificarlo los clics entrarian como basura al filtro.
    """
    datos = b""
    while len(datos) < 3:
        if not select.select([fd], [], [], 0.05)[0]:
            return "esc"
        datos += os.read(fd, 3 - len(datos))
    boton, _col, fila = (b - 32 for b in datos[:3])
    if boton == 3:          # en X10 el release no dice que boton se solto
        return "mouse-release"
    return _mouse_event(boton & 0x43, fila)


def read_key(timeout=None):
    """
    Una pulsacion en modo raw. Devuelve 'up','down','enter','esc','q','refresh',
    'alt-<digito>', 'click:<fila>', 'wheelup','wheeldn', un digito, o None si vencio
    el timeout (para refrescar sin bloquear).
    """
    fd = sys.stdin.fileno()
    old = termios.tcgetattr(fd)
    try:
        # TCSANOW, no el TCSAFLUSH que usa tty.setraw() por defecto: FLUSH descarta la
        # entrada recibida y no leida, y como aqui se entra en modo raw en CADA lectura,
        # todo lo que llegaba mientras el panel repintaba se tiraba. Medido: de 5 teclas
        # seguidas sobrevivia 1. Rompia el doble clic (press,release,press,release llegan
        # juntos) y comia letras al escribir rapido en el filtro.
        tty.setraw(fd, termios.TCSANOW)
        if timeout is not None and not select.select([fd], [], [], timeout)[0]:
            return None
        crudo = os.read(fd, 1)
        if crudo and crudo[0] >= 0xC0:
            # UTF-8 multibyte: cuantos bytes son lo dice el primero. Sin juntarlos, leer
            # de a un byte parte el caracter y `decode(errors="ignore")` lo tira entero:
            # no se podian escribir acentos ni ñ, ni al filtrar ni en una nota.
            faltan = 1 if crudo[0] < 0xE0 else (2 if crudo[0] < 0xF0 else 3)
            while faltan and select.select([fd], [], [], 0.05)[0]:
                crudo += os.read(fd, 1)
                faltan -= 1
        ch = crudo.decode("utf-8", "ignore")
        if ch == "\x1b":  # secuencia de escape: flechas, Alt-<digito> o Esc suelto
            if not select.select([fd], [], [], 0.05)[0]:
                return "esc"
            # Byte a byte, no os.read(fd, 2): hay que decidir con el primero si es una
            # secuencia CSI ('[') o un Alt-<digito>, que no lleva corchete.
            nxt = os.read(fd, 1).decode("utf-8", "ignore")
            if nxt.isdigit():
                return "alt-" + nxt   # Option-N (con "Esc+") o Cmd-N remapeado en iTerm
            if nxt != "[":
                return "esc"
            if not select.select([fd], [], [], 0.05)[0]:
                return "esc"
            rest = os.read(fd, 1).decode("utf-8", "ignore")
            if rest == "<":
                return _read_mouse_sgr(fd)
            if rest == "M":
                return _read_mouse_x10(fd)
            key = {"A": "up", "B": "down", "5": "pgup", "6": "pgdn"}.get(rest, "esc")
            # PgUp/PgDn son ESC [ 5 ~ / ESC [ 6 ~ : hay que comerse la tilde. Sin esto
            # quedaba en el buffer y la lectura siguiente la veia como un '~' escrito,
            # que arrancaba un filtro por "~" al pulsar PgDn.
            if key in ("pgup", "pgdn") and select.select([fd], [], [], 0.05)[0]:
                os.read(fd, 1)
            return key
        if ch in ("\r", "\n"):
            return "enter"
        if ch in ("\x03", "\x04"):  # Ctrl-C / Ctrl-D
            return "q"
        if ch == "\x12":            # Ctrl-R: refrescar
            return "refresh"
        if ch == "\x0e":            # Ctrl-N: escribir la nota de este repo
            return "note"
        if ch == "\x7f":
            return "back"
        return ch
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old)


class Feed:
    """Refresca las sesiones en segundo plano para que la interfaz no se congele."""

    def __init__(self, rows):
        self.rows = rows
        self.lock = threading.Lock()
        self.stamp = 0
        self.last_input = time.time()
        self._stop = threading.Event()
        self._wake = threading.Event()  # para forzar un refresco inmediato con 'r'
        self._t = threading.Thread(target=self._loop, daemon=True)
        self._t.start()

    def _loop(self):
        while not self._stop.is_set():
            # Cada refresco cuesta ~0.2s de CPU (claude agents + osascript). A 4s fijos
            # eso es ~5% de un nucleo indefinidamente, asi que si dejas el panel
            # abierto y sin tocar, se relaja hasta REFRESH_IDLE.
            idle = time.time() - self.last_input
            interval = REFRESH_SECONDS if idle < IDLE_AFTER else REFRESH_IDLE
            self._wake.wait(interval)
            self._wake.clear()
            if self._stop.is_set():
                return
            try:
                fresh = collect()
            except Exception:
                continue  # un fallo puntual no debe tumbar el panel
            with self.lock:
                self.rows = fresh
                self.stamp += 1

    def touch(self):
        """El usuario interactuo: volver al refresco rapido."""
        self.last_input = time.time()

    def snapshot(self):
        with self.lock:
            return self.rows, self.stamp

    def force(self):
        self._wake.set()

    def stop(self):
        self._stop.set()
        self._wake.set()


