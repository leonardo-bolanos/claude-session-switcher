class SessionsUnavailable(Exception):
    """No se pudo consultar a `claude`. Distinto de 'hay cero sesiones'."""


def config_dirs():
    """
    Directorios de configuracion de Claude Code a consultar.

    Por defecto ~/.claude mas cualquier hermano ~/.claude-<algo> que tenga projects/
    dentro (asi se ven las sesiones de una segunda cuenta sin configurar nada).
    Se puede fijar la lista con CCL_CONFIG_DIRS, separada por ':'.
    """
    override = os.environ.get("CCL_CONFIG_DIRS")
    if override:
        dirs = [os.path.expanduser(p) for p in override.split(":") if p.strip()]
        return [d for d in dirs if os.path.isdir(d)]

    found = [os.path.join(HOME, ".claude")]
    for name in sorted(os.listdir(HOME)):
        if not name.startswith(".claude-"):
            continue
        path = os.path.join(HOME, name)
        if os.path.isdir(os.path.join(path, "projects")):
            found.append(path)
    return [d for d in found if os.path.isdir(d)]


def account_label(cfg_dir):
    """'' para el principal, '-personal' para ~/.claude-personal, etc."""
    base = os.path.basename(cfg_dir)
    return "" if base == ".claude" else base.replace(".claude-", "", 1)


# Donde buscar `claude` si no esta en el PATH, en orden. El glob de nvm cubre npm bajo
# nvm, que es lo mas comun y lo peor: la ruta lleva la version de Node y cambia al
# actualizarla, asi que no se puede fijar a mano en la config de nadie.
CLAUDE_EXTRA = [
    "~/.claude/local/claude",              # instalador oficial
    "~/.local/bin/claude",
    "/opt/homebrew/bin/claude",
    "/usr/local/bin/claude",
    "~/.nvm/versions/node/*/bin/claude",   # npm bajo nvm
    "~/.volta/bin/claude",
    "~/.bun/bin/claude",
]

_claude_bin = None   # cache: el glob no se repite en cada refresco (cada 4s)


def claude_bin():
    """
    Ruta del ejecutable `claude`, buscando fuera del PATH si hace falta.

    Un lanzador (Hammerspoon, Raycast, launchd, cron) arranca el proceso con el PATH
    minimo de launchd — `/usr/bin:/bin:/usr/sbin:/sbin` — donde `claude` NO esta. Sin
    esta busqueda, `ccl -w` fallaba desde un atajo global y funcionaba desde la terminal,
    que es el peor sintoma posible: parece cosa del atajo y no lo es.
    """
    global _claude_bin
    if _claude_bin:
        return _claude_bin
    hallado = shutil.which("claude")
    if not hallado:
        cands = []
        for patron in CLAUDE_EXTRA:
            cands.extend(glob.glob(os.path.expanduser(patron)))
        cands = [c for c in cands if os.access(c, os.X_OK)]
        # el mas reciente por fecha, NO por nombre: con varias versiones de Node hay un
        # `claude` por cada una, y ordenar los nombres pone v25.9.0 delante de v25.10.0
        if cands:
            hallado = max(cands, key=lambda p: os.stat(p).st_mtime)
    _claude_bin = hallado
    return hallado


def _sessions_from(cfg_dir):
    env = dict(os.environ, CLAUDE_CONFIG_DIR=cfg_dir)
    try:
        proc = subprocess.run(
            [claude_bin() or "claude", "agents", "--cwd", HOME, "--json"],
            capture_output=True, text=True, timeout=30, env=env,
            stdin=subprocess.DEVNULL,
        )
    except FileNotFoundError:
        raise SessionsUnavailable(t("sin_comando"))
    except subprocess.TimeoutExpired:
        raise SessionsUnavailable(t("timeout"))
    except Exception as e:
        raise SessionsUnavailable(t("no_pude_ejecutar", error=e))

    try:
        out = json.loads(proc.stdout)
    except ValueError:
        detail = (proc.stderr or proc.stdout or "").strip().splitlines()
        pista = t("dijo", detalle=detail[0][:120]) if detail else ""
        raise SessionsUnavailable(t("no_es_json", pista=pista))
    for s in out:
        s["_cfg"] = cfg_dir
        s["_account"] = account_label(cfg_dir)
    return out


def get_sessions():
    """
    Sesiones de TODAS las cuentas detectadas, cada una etiquetada con la suya.

    Lanza SessionsUnavailable solo si falla la primera cuenta (el caso de "claude no
    esta instalado"). Si una cuenta secundaria falla, se ignora: no tiene sentido
    dejar sin panel al usuario porque una config extra este rota.
    """
    # Orden del diagnostico, de la causa mas profunda a la mas superficial: si falta
    # el comando, decirlo primero. Al reves, alguien sin Claude Code instalado leia
    # "no hay directorio de config", que manda a buscar el problema equivocado.
    if claude_bin() is None:
        raise SessionsUnavailable(t("sin_comando"))

    dirs = config_dirs()
    if not dirs:
        raise SessionsUnavailable(t("sin_config", home=HOME))

    todas, primero = [], True
    for d in dirs:
        try:
            todas.extend(_sessions_from(d))
        except SessionsUnavailable:
            if primero:
                raise
        primero = False
    return todas


def get_ttys(pids):
    """Un solo `ps` para todos los PIDs -> {pid: tty}."""
    if not pids:
        return {}
    try:
        out = subprocess.run(
            ["ps", "-o", "pid=,tty=", "-p", ",".join(str(p) for p in pids)],
            capture_output=True, text=True, timeout=10, stdin=subprocess.DEVNULL,
        ).stdout
    except Exception:
        return {}
    result = {}
    for line in out.strip().splitlines():
        parts = line.split()
        if len(parts) >= 2:
            result[int(parts[0])] = parts[1]
    return result


# ─────────────── Spaces de macOS (opcional, via Hammerspoon) ───────────────
#
# Recordar en QUE escritorio vivia una sesion, y devolverla ahi al recuperarla.
#
# **Mover una ventana a un Space esta roto desde macOS 15** (`hs.spaces.moveWindowToSpace`
# devuelve true sin mover nada), y el apaño que queda —arrastrar la miniatura en Mission
# Control— con iTerm falla: la suelta en pantalla completa. Por eso aqui NO se mueve nada.
#
# Se hace al reves: se CAMBIA al Space destino y se crea la ventana alli. Una ventana nueva
# nace en el Space activo de la pantalla donde esta el cursor — verificado. Sin arrastres y
# sin Mission Control.
#
# Todo esto es opcional: sin Hammerspoon, `_hs()` devuelve None y `ccl` funciona igual.

_LUA_ORDENADOS = """
local orden = {}
for _, p in ipairs(hs.screen.allScreens()) do
  for _, sid in ipairs(hs.spaces.spacesForScreen(p:id()) or {}) do
    if hs.spaces.spaceType(sid) == "user" then orden[#orden+1] = sid end
  end
end
"""


def _hs(lua, marca, timeout=8):
    """
    Lo que imprima `print(marca .. " " .. algo)` en Hammerspoon, o None.

    Se busca una MARCA en vez de leer la salida entera porque `hs -c` escupe tambien sus
    "-- Loading extension: ..." la primera vez que toca una extension.
    """
    if not shutil.which("hs"):
        return None
    try:
        res = subprocess.run(["hs", "-t", str(timeout), "-c", lua],
                             capture_output=True, text=True, timeout=timeout + 5,
                             stdin=subprocess.DEVNULL)
    except (OSError, subprocess.SubprocessError):
        return None
    if res.returncode != 0:
        return None
    for linea in res.stdout.splitlines():
        if linea.startswith(marca + " "):
            return linea[len(marca) + 1:].strip()
    return None


def space_actual():
    """
    El ordinal (1..N) del Space activo, o None si no se puede saber.

    Ordinal y no ID, por lo mismo que en el sistema de restauracion del usuario: los IDs de
    Space cambian entre reinicios. El orden es el de `allScreens()`, y dentro de cada
    pantalla el de `spacesForScreen`, contando solo los de tipo `user`.
    """
    salida = _hs(_LUA_ORDENADOS + """
      -- El Space de la VENTANA de delante, no el "Space activo". Parece lo mismo y no lo
      -- es: `focusedSpace()` describe la PANTALLA, y el cambio de escritorio que dispara
      -- el `activate` del AppleScript se anima de forma asincrona — osascript vuelve en
      -- cuanto despacha el evento, no cuando acaba la transicion. Leyendo ahi se apunta
      -- el escritorio del que VIENES, y quedaba guardada la respuesta equivocada.
      -- `windowSpaces` es una propiedad de la ventana: no depende de la animacion.
      local actual = nil
      local w = hs.window.frontmostWindow()
      if w then
        local suyos = hs.spaces.windowSpaces(w)
        if suyos and #suyos > 0 then actual = suyos[1] end
      end
      actual = actual or hs.spaces.focusedSpace()
      for i, sid in ipairs(orden) do
        if sid == actual then print("CCLSPACE " .. i) return end
      end
      print("CCLSPACE 0")
    """, "CCLSPACE")
    if not salida or not salida.isdigit() or salida == "0":
        return None
    return int(salida)


def ir_a_space(ordinal):
    """
    Cambia al Space `ordinal` y deja el cursor en su pantalla. True si se pudo.

    Lo del cursor no es un detalle: iTerm crea la ventana nueva en la pantalla donde esta
    el raton, asi que sin moverlo la ventana nace en el monitor equivocado y todo el
    ejercicio no sirve de nada. Medido: pasaba siempre.
    """
    salida = _hs(_LUA_ORDENADOS + """
      local destino = orden[%d]
      if not destino then print("CCLGOTO 0") return end
      for _, p in ipairs(hs.screen.allScreens()) do
        for _, sid in ipairs(hs.spaces.spacesForScreen(p:id()) or {}) do
          if sid == destino then
            local f = p:fullFrame()
            hs.mouse.absolutePosition({x = f.x + f.w / 2, y = f.y + f.h / 2})
          end
        end
      end
      hs.spaces.gotoSpace(destino)
      print("CCLGOTO 1")
    """ % int(ordinal), "CCLGOTO")
    return salida == "1"


def recordar_space(session_id):
    """
    Apunta en que Space esta ahora esa sesion. Se llama tras enfocarla con exito.

    Se aprende USANDO `ccl`: enfocar una sesion trae su ventana al frente, o sea que el
    Space activo en ese momento **es** el suyo. Nada de escanear ventanas ni de emparejar
    identificadores de iTerm con los de Hammerspoon, que son mundos distintos.
    """
    ordinal = space_actual()
    if not ordinal:
        return None
    sesion, repo, pausadas, spaces = load_state()
    if spaces.get(session_id) == ordinal:
        return ordinal            # sin cambios: no se reescribe el archivo por nada
    spaces[session_id] = ordinal
    guardar_estado(sesion, repo, pausadas, spaces)
    return ordinal


def _tmux(*args):
    """Salida de un comando de tmux, o None si no hay tmux o no hay servidor."""
    if not shutil.which("tmux"):
        return None
    try:
        res = subprocess.run(["tmux"] + list(args), capture_output=True, text=True,
                             timeout=5, stdin=subprocess.DEVNULL)
    except (OSError, subprocess.SubprocessError):
        return None
    # sin servidor levantado tmux sale con error y un "no server running": no es un
    # fallo, es el caso normal de quien no usa tmux
    return res.stdout if res.returncode == 0 else None


def get_tmux_map():
    """
    {tty del panel: (destino, sesion, tty del cliente)} para las sesiones dentro de tmux.

    Existe porque una sesion en un panel de tmux es INVISIBLE para `get_iterm_map()`: su
    tty es el pseudoterminal que creo tmux, no el de iTerm, asi que salia siempre con el ⚠
    de "no la encuentro". Y es justo la que mas interesa localizar, porque sobrevive a que
    el terminal se caiga.

    El `tty del cliente` es donde esta ENGANCHADA esa sesion de tmux, y ese si es un tty de
    iTerm: es el puente entre los dos mapas. Vale None si la sesion esta suelta (detached),
    que no es un error — es el caso de "se cayo iTerm y tmux siguio vivo".

    Dos consultas y ya (~11 ms). Misma leccion que con AppleScript: nada de un comando por
    sesion.
    """
    paneles = _tmux("list-panes", "-a", "-F",
                    "#{pane_tty}\t#{session_name}:#{window_index}.#{pane_index}"
                    "\t#{session_name}")
    if not paneles:
        return {}
    clientes = {}
    for linea in (_tmux("list-clients", "-F", "#{client_session}\t#{client_tty}") or
                  "").splitlines():
        partes = linea.split("\t")
        if len(partes) == 2 and partes[1]:
            clientes[partes[0]] = partes[1]

    mapa = {}
    for linea in paneles.splitlines():
        partes = linea.split("\t")
        if len(partes) != 3 or not TTY_RE.fullmatch(partes[0]):
            continue
        tty, destino, sesion = partes
        mapa[tty.replace("/dev/", "")] = (destino, sesion,
                                          clientes.get(sesion, "").replace("/dev/", ""))
    return mapa


def _parsear_mapa(salida, app):
    """
    {tty: (app, ventana, pestaña)} a partir de "id:n,id:n,...@@@tty,tty,...".

    Compartido por iTerm2 y Terminal.app porque las dos consultas devuelven la misma
    forma: los conteos por ventana permiten reconstruir a que pestaña pertenece cada tty
    de la lista plana, que viene en orden ventana > pestaña.
    """
    if "@@@" not in salida:
        return {}
    cabecera, ttys = salida.split("@@@", 1)
    ventanas = [p.split(":") for p in cabecera.strip().rstrip(",").split(",") if ":" in p]
    # Validar la forma: si los text item delimiters fallaran, los ttys llegarian
    # concatenados ("/dev/ttys001/dev/ttys002") y produciriamos claves basura que
    # no casan con nada. Mejor descartarlas y que se vea el aviso de "no la encuentro".
    lista = [t for t in (x.strip() for x in ttys.split(",")) if TTY_RE.fullmatch(t)]

    resultado = {}
    i = 0
    for wid, cuenta in ventanas:
        try:
            n = int(cuenta)
        except ValueError:
            continue
        for pestaña in range(1, n + 1):
            if i >= len(lista):
                break
            resultado[lista[i].replace("/dev/", "")] = (app, wid.strip(), pestaña)
            i += 1
    return resultado


def _consultar(script):
    """La salida de un AppleScript, o "" si falla. Nunca revienta."""
    try:
        return subprocess.run(
            ["osascript", "-e", script], capture_output=True, text=True, timeout=15,
            stdin=subprocess.DEVNULL,
        ).stdout.strip()
    except Exception:
        return ""


def get_iterm_map():
    """
    {tty: ("iTerm2", window_id, tab_index)}. Vacio si iTerm no corre.

    Usa dos gets masivos en vez de recorrer sesion por sesion: resolver la ruta
    completa (`tty of session s of tab t of window w`) cuesta una llamada IPC por
    propiedad y tardaba 2.2s con 44 pestañas. Asi baja a ~0.5s.

    El `is running` no es decoracion: sin el, `tell application "iTerm2"` **lanza iTerm**
    si no esta abierto. Un `ccl --list` desde un script no puede abrirle a nadie una
    ventana que no habia pedido.
    """
    return _parsear_mapa(_consultar('''
    if application "iTerm2" is running then
      tell application "iTerm2"
        set AppleScript's text item delimiters to ","
        set r to ""
        repeat with w in windows
          set r to r & ((id of w) as text) & ":" & ((count of tabs of w) as text) & ","
        end repeat
        set tl to (tty of sessions of tabs of windows) as text
        set AppleScript's text item delimiters to ""
        return r & "@@@" & tl
      end tell
    end if
    return ""
    '''), "iTerm2")


def get_terminal_map():
    """
    {tty: ("Terminal", window_id, tab_index)} para Terminal.app. Vacio si no corre.

    Misma forma que iTerm y por las mismas razones, con una diferencia de estructura:
    Terminal.app no tiene "sesiones" dentro de las pestañas, asi que el tty cuelga
    directamente de la pestaña.

    Sale practicamente gratis para quien no use Terminal.app: el `is running` corta antes
    de hablar con nadie. Medido en una maquina donde no corria: ~30 ms.
    """
    return _parsear_mapa(_consultar('''
    if application "Terminal" is running then
      tell application "Terminal"
        set AppleScript's text item delimiters to ","
        set r to ""
        repeat with w in windows
          set r to r & ((id of w) as text) & ":" & ((count of tabs of w) as text) & ","
        end repeat
        set tl to (tty of tabs of windows) as text
        set AppleScript's text item delimiters to ""
        return r & "@@@" & tl
      end tell
    end if
    return ""
    '''), "Terminal")


def read_transcript(session_id, cfg_dir=None):
    """
    Lee solo la cola del transcript. Todo campo es opcional.

    `cfg_dir` es el directorio de config de la cuenta duena de la sesion; sin el se
    buscaria siempre en ~/.claude y las sesiones de una segunda cuenta saldrian sin
    rama, modelo ni ultimo prompt.
    """
    info = {}
    base = cfg_dir or os.path.join(HOME, ".claude")
    hits = glob.glob(os.path.join(base, "projects", "*", f"{session_id}.jsonl"))
    if not hits:
        return info
    try:
        with open(hits[0], "rb") as fh:
            fh.seek(0, os.SEEK_END)
            size = fh.tell()
            fh.seek(max(0, size - TAIL_BYTES))
            chunk = fh.read().decode("utf-8", "ignore")
    except Exception:
        return info

    for line in chunk.split("\n"):
        line = line.strip()
        if not line:
            continue
        try:
            o = json.loads(line)
        except Exception:
            continue  # linea truncada por el corte de la cola
        if not isinstance(o, dict):
            continue
        # `cwd` hace falta para reanudar una sesion muerta: `claude --resume` tiene que
        # lanzarse en su directorio o abre la conversacion en el sitio equivocado.
        for key, field in (("timestamp", "ts"), ("gitBranch", "branch"),
                           ("effort", "effort"), ("cwd", "cwd")):
            if o.get(key):
                info[field] = o[key]
        if o.get("type") == "ai-title" and o.get("aiTitle"):
            info["title"] = o["aiTitle"]
        if o.get("type") == "last-prompt" and o.get("lastPrompt"):
            info["prompt"] = o["lastPrompt"]
        msg = o.get("message")
        if isinstance(msg, dict) and msg.get("model"):
            info["model"] = msg["model"]
    return info


def leer_json(ruta, defecto):
    """
    El JSON de `ruta`, o `defecto` si falta, esta corrupto o no se puede leer.

    Los dos indices que guarda `ccl` (numeros y notas) son cache o comodidad, nunca datos
    que no se puedan regenerar: **un archivo roto no puede impedir que el panel arranque**.
    """
    try:
        with open(ruta) as fh:
            datos = json.load(fh)
    except Exception:
        return defecto
    return datos if isinstance(datos, type(defecto)) else defecto


def escribir_json(ruta, datos):
    """
    Escribe `datos` en `ruta`, creando el directorio. Si falla, se traga el error.

    Sin persistencia se sigue funcionando: se pierde al salir, pero nada mas. Es el mismo
    criterio en los dos indices, y por eso vive en un solo sitio.
    """
    try:
        os.makedirs(os.path.dirname(ruta), exist_ok=True)
        with open(ruta, "w") as fh:
            json.dump(datos, fh, indent=2, ensure_ascii=False, sort_keys=True)
        # 0600: las notas son texto personal —nombres de gente, en que estas esperando— y
        # con el umask habitual (022) el fichero salia legible para el grupo. En una maquina
        # de un solo usuario no hay exposicion real, pero es gratis no dejarlo abierto.
        os.chmod(ruta, 0o600)
    except Exception:
        pass


# ─────────────────────────── numeracion estable ───────────────────────────


def assign_numbers(sessions):
    """sessionId -> numero fijo. Recicla los numeros de sesiones muertas."""
    index = leer_json(INDEX_FILE, {})

    live = {s["sessionId"] for s in sessions}
    index = {sid: n for sid, n in index.items() if sid in live}  # purgar muertas
    used = set(index.values())

    for s in sessions:
        sid = s["sessionId"]
        if sid not in index:
            n = 1
            while n in used:
                n += 1
            index[sid] = n
            used.add(n)

    escribir_json(INDEX_FILE, index)
    return index


